{"ch": 75, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Laa uqsimu biyawmil-qiyaamah"}, {"n": 3, "tl": "Wa laa uqsimu bin-nafsil-lawwaamah"}, {"n": 4, "tl": "Ayahsabul-insaanu allan najma'a izaamah"}, {"n": 5, "tl": "Balaa qaadireena alaa an nusawwiya banaanah"}, {"n": 6, "tl": "Bal yureedul-insaanu liyafjura amaamah"}, {"n": 7, "tl": "Yas'alu ayyaana yawmul-qiyaamah"}, {"n": 8, "tl": "Fa-idhaa bariqal-basar"}, {"n": 9, "tl": "Wa khasafal-qamar"}, {"n": 10, "tl": "Wa jumi'ash-shamsu wal-qamar"}, {"n": 11, "tl": "Yaqoolul-insaanu yawma'idhin aynal-mafarr"}, {"n": 12, "tl": "Kallaa laa wazar"}, {"n": 13, "tl": "Ilaa rabbika yawma'idhin al-mustaqarr"}, {"n": 14, "tl": "Yunabba'ul-insaanu yawma'idhin bimaa qaddama wa akhkhar"}, {"n": 15, "tl": "Balil-insaanu alaa nafsihi baseerah"}, {"n": 16, "tl": "Wa law alqaa ma'aadheerah"}, {"n": 17, "tl": "Laa tuharrik bihi lisaanaka lita'jala bih"}, {"n": 18, "tl": "Inna alaynaa jam'ahu wa qur'aanah"}, {"n": 19, "tl": "Fa-idhaa qara'naahu fattabi qur'aanah"}, {"n": 20, "tl": "Thumma inna alaynaa bayaanah"}, {"n": 21, "tl": "Kallaa bal tuhibboonal-aajilah"}, {"n": 22, "tl": "Wa tadharoonal-aakhirah"}, {"n": 23, "tl": "Wujoohun yawma'idhin naadirah"}, {"n": 24, "tl": "Ilaa rabbihaa naazirah"}, {"n": 25, "tl": "Wa wujoohun yawma'idhin baasirah"}, {"n": 26, "tl": "Tazunnu an yuf'ala bihaa faaqirah"}, {"n": 27, "tl": "Kallaa idhaa balaghatit-taraaqee"}, {"n": 28, "tl": "Wa qeela man raaq"}, {"n": 29, "tl": "Wa zanna annahul-firaaq"}, {"n": 30, "tl": "Waltaffatis-saaqu bis-saaq"}, {"n": 31, "tl": "Ilaa rabbika yawma'idhin al-masaaq"}, {"n": 32, "tl": "Falaa saddaqa wa laa sallaa"}, {"n": 33, "tl": "Wa laakin kadhdhaba wa tawallaa"}, {"n": 34, "tl": "Thumma dhahaba ilaa ahlihi yatamattaa"}, {"n": 35, "tl": "Awlaa laka fa-awlaa"}, {"n": 36, "tl": "Thumma awlaa laka fa-awlaa"}, {"n": 37, "tl": "Ayahsabul-insaanu an yutraka sudaa"}, {"n": 38, "tl": "Alam yaku nutfatan min maniyyin yumnaa"}, {"n": 39, "tl": "Thumma kaana alaqatan fakhalaqa fasawwaa"}, {"n": 40, "tl": "Faja'ala minhuz-zawjaynidh-dhakara wal-unthaa"}, {"n": 41, "tl": "Alaysa dhaalika biqaadirin alaa an yuhyiyal-mawtaa"}]}
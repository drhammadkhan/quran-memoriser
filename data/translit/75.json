{"ch": 75, "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Lā 'Uqsimu Biyawmi Al-Qiyāmahi"}, {"n": 3, "tl": "Wa Lā 'Uqsimu Bin-Nafsi Al-Lawwāmahi"}, {"n": 4, "tl": "'Ayaĥsabu Al-'Insānu 'Allan Najma`a `Ižāmahu"}, {"n": 5, "tl": "Balá Qādirīna `Alá 'An Nusawwiya Banānahu"}, {"n": 6, "tl": "Bal Yurīdu Al-'Insānu Liyafjura 'Amāmahu"}, {"n": 7, "tl": "Yas'alu 'Ayyāna Yawmu Al-Qiyāmahi"}, {"n": 8, "tl": "Fa'idhā Bariqa Al-Başaru"}, {"n": 9, "tl": "Wa Khasafa Al-Qamaru"}, {"n": 10, "tl": "Wa Jumi`a Ash-Shamsu Wa Al-Qamaru"}, {"n": 11, "tl": "Yaqūlu Al-'Insānu Yawma'idhin 'Ayna Al-Mafarru"}, {"n": 12, "tl": "Kallā Lā Wazara"}, {"n": 13, "tl": "'Ilá Rabbika Yawma'idhin Al-Mustaqarru"}, {"n": 14, "tl": "Yunabba'u Al-'Insānu Yawma'idhin Bimā Qaddama Wa 'Akhkhara"}, {"n": 15, "tl": "Bali Al-'Insānu `Alá Nafsihi Başīrahun"}, {"n": 16, "tl": "Wa Law 'Alqá Ma`ādhīrahu"}, {"n": 17, "tl": "Lā Tuĥarrik Bihi Lisānaka Lita`jala Bihi"}, {"n": 18, "tl": "'Inna `Alaynā Jam`ahu Wa Qur'ānahu"}, {"n": 19, "tl": "Fa'idhā Qara'nāhu Fa Attabi` Qur'ānahu"}, {"n": 20, "tl": "Thumma 'Inna `Alaynā Bayānahu"}, {"n": 21, "tl": "Kallā Bal Tuĥibbūna Al-`Ājilaha"}, {"n": 22, "tl": "Wa Tadharūna Al-'Ākhiraha"}, {"n": 23, "tl": "Wujūhun Yawma'idhin Nāđirahun"}, {"n": 24, "tl": "'Ilá Rabbihā Nāžirahun"}, {"n": 25, "tl": "Wa Wujūhun Yawma'idhin Bāsirahun"}, {"n": 26, "tl": "Tažunnu 'An Yuf`ala Bihā Fāqirahun"}, {"n": 27, "tl": "Kallā 'Idhā Balaghati At-Tarāqī"}, {"n": 28, "tl": "Wa Qīla Man Rāqin"}, {"n": 29, "tl": "Wa Žanna 'Annahu Al-Firāqu"}, {"n": 30, "tl": "Wa Altaffati As-Sāqu Bis-Sāqi"}, {"n": 31, "tl": "'Ilá Rabbika Yawma'idhin Al-Masāqu"}, {"n": 32, "tl": "Falā Şaddaqa Wa Lā Şallá"}, {"n": 33, "tl": "Wa Lakin Kadhdhaba Wa Tawallá"}, {"n": 34, "tl": "Thumma Dhahaba 'Ilá 'Ahlihi Yatamaţţá"}, {"n": 35, "tl": "'Awlá Laka Fa'awlá"}, {"n": 36, "tl": "Thumma 'Awlá Laka Fa'awlá"}, {"n": 37, "tl": "'Ayaĥsabu Al-'Insānu 'An Yutraka Sudan"}, {"n": 38, "tl": "'Alam Yaku Nuţfata
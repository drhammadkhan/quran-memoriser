{"ch": 89, "source": "transliteration.org", "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Wa Al-Fajri"}, {"n": 3, "tl": "Wa Layālin `Ashrin"}, {"n": 4, "tl": "Wa Ash-Shaf`i Wa Al-Watri"}, {"n": 5, "tl": "Wa Al-Layli 'Idhā Yasri"}, {"n": 6, "tl": "Hal Fī Dhālika Qasamun Lidhī Ĥijrin"}, {"n": 7, "tl": "'Alam Tara Kayfa Fa`ala Rabbuka Bi`ādin"}, {"n": 8, "tl": "'Irama Dhāti Al-`Imādi"}, {"n": 9, "tl": "Allatī Lam Yukhlaq Mithluhā Fī Al-Bilādi"}, {"n": 10, "tl": "Wa Thamūda Al-Ladhīna Jābū Aş-Şakhra Bil-Wādi"}, {"n": 11, "tl": "Wa Fir`awna Dhī Al-'Awtādi"}, {"n": 12, "tl": "Al-Ladhīna Ţaghawā Fī Al-Bilādi"}, {"n": 13, "tl": "Fa'aktharū Fīhā Al-Fasāda"}, {"n": 14, "tl": "Faşabba `Alayhim Rabbuka Sawţa `Adhābin"}, {"n": 15, "tl": "'Inna Rabbaka Labiālmirşādi"}, {"n": 16, "tl": "Fa'ammā Al-'Insānu 'Idhā Mā Abtalāhu Rabbuhu Fa'akramahu Wa Na``amahu Fayaqūlu Rabbī 'Akramani"}, {"n": 17, "tl": "Wa 'Ammā 'Idhā Mā Abtalāhu Faqadara `Alayhi Rizqahu Fayaqūlu Rabbī 'Ahānani"}, {"n": 18, "tl": "Kallā Bal Lā Tukrimūna Al-Yatīma"}, {"n": 19, "tl": "Wa Lā Taĥāđđūna `Alá Ţa`āmi Al-Miskīni"}, {"n": 20, "tl": "Wa Ta'kulūna At-Turātha 'Aklāan Lammāan"}, {"n": 21, "tl": "Wa Tuĥibbūna Al-Māla Ĥubbāan Jammāan"}, {"n": 22, "tl": "Kallā 'Idhā Dukkati Al-'Arđu Dakkāan Dakkāan"}, {"n": 23, "tl": "Wa Jā'a Rabbuka Wa Al-Malaku Şaffāan Şaffāan"}, {"n": 24, "tl": "Wa Jī'a Yawma'idhin Bijahannama Yawma'idhin Yatadhakkaru Al-'Insānu Wa 'Anná Lahu Adh-Dhikrá"}, {"n": 25, "tl": "Yaqūlu Yā Laytanī Qaddamtu Liĥayātī"}, {"n": 26, "tl": "Fayawma'idhin Lā Yu`adhdhibu `Adhābahu 'Aĥadun"}, {"n": 27, "tl": "Wa Lā Yūthiqu Wathāqahu 'Aĥadun"}, {"n": 28, "tl": "Yā 'Ayyatuhā An-Nafsu Al-Muţma'innahu"}, {"n": 29, "tl": "Arji`ī 'Ilá Rabbiki Rāđiyatan Marđīyahan"}, {"n": 30, "tl": "Fādkhulī Fī `Ibādī"}, {"n": 31, "tl": "Wa Adkhulī Jannatī"}]}
{"ch": 89, "verses": [{"n": 2, "tl": "Wa Al-Fajri"}, {"n": 3, "tl": "Wa Layālin `Ashrin"}, {"n": 4, "tl": "Wa Ash-Shaf`i Wa Al-Watri"}, {"n": 6, "tl": "Hal Fī Dhālika Qasamun Lidhī Ĥijrin"}, {"n": 7, "tl": "'Alam Tara Kayfa Fa`ala Rabbuka Bi`ādin"}, {"n": 8, "tl": "'Irama Dhāti Al-`Imādi"}, {"n": 9, "tl": "Allatī Lam Yukhlaq Mithluhā Fī Al-Bilādi"}, {"n": 10, "tl": "Wa Thamūda Al-Ladhīna Jābū Aş-Şakhra Bil-Wādi"}, {"n": 11, "tl": "Wa Fir`awna Dhī Al-'Awtādi"}, {"n": 12, "tl": "Al-Ladhīna Ţaghaw Fī Al-Bilādi"}, {"n": 13, "tl": "Fa'aktharū Fīhā Al-Fasāda"}, {"n": 14, "tl": "Faşabba `Alayhim Rabbuka Sawţa `Adhābin"}, {"n": 15, "tl": "'Inna Rabbaka Labiālmirşādi"}, {"n": 18, "tl": "Kallā Bal Lā Tukrimūna Al-Yatīma"}, {"n": 19, "tl": "Wa Lā Taĥāđđūna `Alá Ţa`āmi Al-Miskīni"}, {"n": 20, "tl": "Wa Ta'kulūna At-Turātha 'Aklāan Lammāan"}, {"n": 21, "tl": "Wa Tuĥibbūna Al-Māla Ĥubbāan Jammāan"}, {"n": 22, "tl": "Kallā Idhā Dukkati Al-'Arđu Dakkāan Dakkāan"}, {"n": 23, "tl": "Wa Jā'a Rabbuka Wa Al-Malaku Şaffāan Şaffāan"}, {"n": 24, "tl": "Wa Jī'a Yawma'idhin Bijahannama Yawma'idhin Yatadhakkaru Al-'Insānu Wa 'Anná"}, {"n": 25, "tl": "Yaqūlu Yā Laytanī Qaddamtu Liĥayātī"}, {"n": 26, "tl": "Fayawma'idhin Lā Yu`adhdhibu `Adhābahu 'Aĥadun"}, {"n": 27, "tl": "~ Wa Lā Yūthiqu Wathāqahu 'Aĥadun"}, {"n": 29, "tl": "A rji`ī 'Ilá Rabbiki Rāđiyatan Marđīyahan"}, {"n": 30, "tl": "Fādkhulī Fī `Ibādī"}, {"n": 31, "tl": "Wa Adkhulī Jannatī"}]}
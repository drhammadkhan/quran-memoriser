{"ch": 89, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Wal-fajr"}, {"n": 3, "tl": "Wa layaalin ashr"}, {"n": 4, "tl": "Wash-shaf'i wal-watr"}, {"n": 5, "tl": "Wal-layli idhaa yasr"}, {"n": 6, "tl": "Hal fee dhaalika qasamun lidhee hijr"}, {"n": 7, "tl": "Alam tara kayfa fa-ala rabbuka bi-aad"}, {"n": 8, "tl": "Irama dhaatil-imaad"}, {"n": 9, "tl": "Allatee lam yukhlaq mithluhaa fil-bilaad"}, {"n": 10, "tl": "Wa thamoodal-ladheena jaabus-sakhra bil-waad"}, {"n": 11, "tl": "Wa fir'awna dhil-awtaad"}, {"n": 12, "tl": "Al-ladheena taghaw fil-bilaad"}, {"n": 13, "tl": "Fa-aktharoo feehal-fasaad"}, {"n": 14, "tl": "Fasabba alayhim rabbuka sawta adhaab"}, {"n": 15, "tl": "Inna rabbaka labiaalmirsaad"}, {"n": 16, "tl": "Fa-ammal-insaanu idhaa mab-talaahu rabbuhu fa-akramahu wa na'amahu fayaqoolu rabbee akraman"}, {"n": 17, "tl": "Wa ammaa idhaa mab-talaahu faqadara alayhi rizqahu fayaqoolu rabbee ahaanan"}, {"n": 18, "tl": "Kallaa bal laa tukrimoonal-yateem"}, {"n": 19, "tl": "Wa laa tahaaddoona alaa ta'aamil-miskeen"}, {"n": 20, "tl": "Wa ta'kuloonat-turaatha aklan lammaa"}, {"n": 21, "tl": "Wa tuhibboonal-maala hubban jammaa"}, {"n": 22, "tl": "Kallaa idhaa dukkatil-ardu dakkan dakkaa"}, {"n": 23, "tl": "Wa jaa'a rabbuka wal-malaku saffan saffaa"}, {"n": 24, "tl": "Wa jee'a yawma'idhin bijahannama yawma'idhin yatadhakkarul-insaanu wa annaa lahudh-dhikraa"}, {"n": 25, "tl": "Yaqoolu yaa laytanee qaddamtu lihayaatee"}, {"n": 26, "tl": "Fayawma'idhin laa yu'adhdhibu adhaabahu ahad"}, {"n": 27, "tl": "Wa laa yoothiqu wathaaqahu ahad"}, {"n": 28, "tl": "Yaa ayyatuhan-nafsul-mutma'innah"}, {"n": 29, "tl": "Irji'ee ilaa rabbiki raadiyatan mardiyyah"}, {"n": 30, "tl": "Fadkhulee fee ibaadee"}, {"n": 31, "tl": "Wadkhulee jannatee"}]}
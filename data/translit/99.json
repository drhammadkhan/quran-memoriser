{"ch": 99, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Idhaa zulzilatil-ardu zilzaalahaa"}, {"n": 3, "tl": "Wa akhrajatil-ardu athqaalahaa"}, {"n": 4, "tl": "Wa qaalal-insaanu maa lahaa"}, {"n": 5, "tl": "Yawma'idhin tuhaddithu akhbaarahaa"}, {"n": 6, "tl": "Bi-anna rabbaka awhaa lahaa"}, {"n": 7, "tl": "Yawma'idhin yasdurun-naasu ashtaatan liyuraw a'maalahum"}, {"n": 8, "tl": "Faman ya'mal mithqaala dharratin khayran yarah"}, {"n": 9, "tl": "Wa man ya'mal mithqaala dharratin sharran yarah"}]}
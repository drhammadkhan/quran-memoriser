{"ch": 99, "source": "transliteration.org", "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "'Idhā Zulzilati Al-'Arđu Zilzālahā"}, {"n": 3, "tl": "Wa 'Akhrajati Al-'Arđu 'Athqālahā"}, {"n": 4, "tl": "Wa Qāla Al-'Insānu Mā Lahā"}, {"n": 5, "tl": "Yawma'idhin Tuĥaddithu 'Akhbārahā"}, {"n": 6, "tl": "Bi'anna Rabbaka 'Awĥá Lahā"}, {"n": 7, "tl": "Yawma'idhin Yaşduru An-Nāsu 'Ashtātāan Liyuraw 'A`mālahum"}, {"n": 8, "tl": "Faman Ya`mal Mithqāla Dharratin Khayrāan Yarahu"}, {"n": 9, "tl": "Wa Man Ya`mal Mithqāla Dharratin Sharrāan Yarahu"}]}
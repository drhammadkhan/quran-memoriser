{"ch": 99, "source": "transliteration.org", "verses": [{"n": 2, "tl": "'Idhā Zulzilati Al-'Arđu Zilzālahā"}, {"n": 3, "tl": "Wa 'Akhrajati Al-'Arđu Athqālahā"}, {"n": 4, "tl": "Wa Qāla Al-'Insānu Mā Lahā"}, {"n": 5, "tl": "Yawma'idhin Tuĥaddithu Akhbārahā"}, {"n": 6, "tl": "Bi'anna Rabbaka 'Awĥá Lahā"}, {"n": 7, "tl": "Yawma'idhin Yaşduru An-Nāsu Ashtātāan Liyuraw"}, {"n": 8, "tl": "Faman Ya`mal Mithqāla Dh arratin Kh ayrāan Yarahu"}, {"n": 9, "tl": "Wa Man Ya`mal Mithqāla Dh arratin Sh arrāan Yarahu"}]}
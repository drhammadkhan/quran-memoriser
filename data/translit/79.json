{"ch": 79, "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Wa An-Nāzi`āti Gharqāan"}, {"n": 3, "tl": "Wa An-Nāshiţāti Nashţāan"}, {"n": 4, "tl": "Wa As-Sābiĥāti Sabĥāan"}, {"n": 5, "tl": "Fālssābiqāti Sabqāan"}, {"n": 6, "tl": "Fālmudabbirāti 'Amrāan"}, {"n": 7, "tl": "Yawma Tarjufu Ar-Rājifahu"}, {"n": 8, "tl": "Tatba`uhā Ar-Rādifahu"}, {"n": 9, "tl": "Qulūbun Yawma'idhin Wājifahun"}, {"n": 10, "tl": "'Abşāruhā Khāshi`ahun"}, {"n": 11, "tl": "Yaqūlūna 'A'innā Lamardūdūna Fī Al-Ĥāfirahi"}, {"n": 12, "tl": "'A'idhā Kunnā `Ižāmāan Nakhirahan"}, {"n": 13, "tl": "Qālū Tilka 'Idhāan Karratun Khāsirahun"}, {"n": 14, "tl": "Fa'innamā Hiya Zajratun Wāĥidahun"}, {"n": 15, "tl": "Fa'idhā Hum Bis-Sāhirahi"}, {"n": 16, "tl": "Hal 'Tāka Ĥadīthu Mūsá"}, {"n": 17, "tl": "'Idh Nādāhu Rabbuhu Bil-Wādi Al-Muqaddasi Ţuwan"}, {"n": 18, "tl": "Adh/hab 'Ilá Fir`awna 'Innahu Ţaghá"}, {"n": 19, "tl": "Faqul Hal Laka 'Ilá 'An Tazakká"}, {"n": 20, "tl": "Wa 'Ahdiyaka 'Ilá Rabbika Fatakhshá"}, {"n": 21, "tl": "Fa'arāhu Al-'Āyata Al-Kubrá"}, {"n": 22, "tl": "Fakadhdhaba Wa `Aşá"}, {"n": 23, "tl": "Thumma 'Adbara Yas`á"}, {"n": 24, "tl": "Faĥashara Fanādá"}, {"n": 25, "tl": "Faqāla 'Anā Rabbukumu Al-'A`lá"}, {"n": 26, "tl": "Fa'akhadhahu Allāhu Nakāla Al-'Ākhirati Wa Al-'Ūlá"}, {"n": 27, "tl": "'Inna Fī Dhālika La`ibratan Liman Yakhshá"}, {"n": 28, "tl": "'A'antum 'Ashaddu Khalqāan 'Ami As-Samā'u Banāhā"}, {"n": 29, "tl": "Rafa`a Samkahā Fasawwāhā"}, {"n": 30, "tl": "Wa 'Aghţasha Laylahā Wa 'Akhraja Đuĥāhā"}, {"n": 31, "tl": "Wa Al-'Arđa Ba`da Dhālika Daĥāhā"}, {"n": 32, "tl": "'Akhraja Minhā Mā'ahā Wa Mar`āhā"}, {"n": 33, "tl": "Wa Al-Jibāla 'Arsāhā"}, {"n": 34, "tl": "Matā`āan Lakum Wa Li'an`āmikum"}, {"n": 35, "tl": "Fa'idhā Jā'ati Aţ-Ţāmmatu Al-Kubrá"}, {"n": 36, "tl": "Yawma Yatadhakkaru Al-'Insānu Mā Sa`á"}, {"n": 37, "tl": "Wa Burrizati Al-Jaĥīmu Liman Yará"}, {"n": 38, "tl": "Fa'ammā Man Ţaghá"}, {"n": 39, "tl": "Wa 'Āthara Al-Ĥayāata Ad-Dunyā"}, {"n": 40, "tl": "Fa'inna Al-Jaĥīma Hiya Al-Ma'wá"}, {"n": 41, "tl": "Wa 'Ammā Man Khāfa Maqāma Rabbihi Wa Nahá An-Nafsa `Ani Al-Hawá"}, {"n": 42, "tl": "Fa'inna Al-Jannata Hiya Al-Ma'wá"}, {"n": 43, "tl": "Yas'alūnaka `Ani As-Sā`ati 'Ayyāna Mursāhā"}, {"n": 44, "tl": "Fīma 'Anta Min Dhikrāhā"}, {"n": 45, "tl": "'Ilá Rabbika Muntahāhā"}, {"n": 46, "tl": "'Innamā 'Anta Mundhiru Man Yakhshāhā"}, {"n": 47, "tl": "Ka'annahum Yawma Yarawnahā Lam Yalbathū 'Illā `Ashīyatan 'Aw Đuĥāhā"}]}
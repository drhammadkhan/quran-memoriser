{"ch": 79, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Wan-naazi'aati gharqaa"}, {"n": 3, "tl": "Wan-naashitaati nashtaa"}, {"n": 4, "tl": "Was-saabihaati sabhaa"}, {"n": 5, "tl": "Fas-saabiqaati sabqaa"}, {"n": 6, "tl": "Fal-mudabbiraati amraa"}, {"n": 7, "tl": "Yawma tarjufur-raajifah"}, {"n": 8, "tl": "Tatba'uhar-raadifah"}, {"n": 9, "tl": "Quloobun yawma'idhin waajifah"}, {"n": 10, "tl": "Absaaruhaa khaashi'ah"}, {"n": 11, "tl": "Yaqooloona a'innaa lamardoodoona fil-haafirah"}, {"n": 12, "tl": "A'idhaa kunnaa izaaman nakhirah"}, {"n": 13, "tl": "Qaaloo tilka idhan karratun khaasirah"}, {"n": 14, "tl": "Fa-innamaa hiya zajratun waahidah"}, {"n": 15, "tl": "Fa-idhaa hum bis-saahirah"}, {"n": 16, "tl": "Hal taaka hadeethu moosaa"}, {"n": 17, "tl": "Idh naadaahu rabbuhu bil-waadil-muqaddasi tuwaa"}, {"n": 18, "tl": "Idhhab ilaa fir'awna innahu taghaa"}, {"n": 19, "tl": "Faqul hal laka ilaa an tazakkaa"}, {"n": 20, "tl": "Wa ahdiyaka ilaa rabbika fatakhshaa"}, {"n": 21, "tl": "Fa-araahul-aayatal-kubraa"}, {"n": 22, "tl": "Fakadhdhaba wa asaa"}, {"n": 23, "tl": "Thumma adbara yas'aa"}, {"n": 24, "tl": "Fahashara fanaadaa"}, {"n": 25, "tl": "Faqaala anaa rabbukumul-a'laa"}, {"n": 26, "tl": "Fa-akhadhahu Allaahu nakaalal-aakhirati wal-oolaa"}, {"n": 27, "tl": "Inna fee dhaalika la-ibratan liman yakhshaa"}, {"n": 28, "tl": "A'antum ashaddu khalqan amis-samaa'u banaahaa"}, {"n": 29, "tl": "Rafa'a samkahaa fasawwaahaa"}, {"n": 30, "tl": "Wa aghtasha laylahaa wa akhraja duhaahaa"}, {"n": 31, "tl": "Wal-arda ba'da dhaalika dahaahaa"}, {"n": 32, "tl": "Akhraja minhaa maa'ahaa wa mar'aahaa"}, {"n": 33, "tl": "Wal-jibaala arsaahaa"}, {"n": 34, "tl": "Mataa'an lakum wa li-an'aamikum"}, {"n": 35, "tl": "Fa-idhaa jaa'atit-taammatul-kubraa"}, {"n": 36, "tl": "Yawma yatadhakkarul-insaanu maa sa'aa"}, {"n": 37, "tl": "Wa burrizatil-jaheemu liman yaraa"}, {"n": 38, "tl": "Fa-ammaa man taghaa"}, {"n": 39, "tl": "Wa aatharal-hayaatad-dunyaa"}, {"n": 40, "tl": "Fa-innal-jaheema hiyal-ma'waa"}, {"n": 41, "tl": "Wa ammaa man khaafa maqaama rabbihi wa nahan-nafsa anil-hawaa"}, {"n": 42, "tl": "Fa-innal-jannata hiyal-ma'waa"}, {"n": 43, "tl": "Yas'aloonaka anis-saa'ati ayyaana mursaahaa"}, {"n": 44, "tl": "Feema anta min dhikraahaa"}, {"n": 45, "tl": "Ilaa rabbika muntahaahaa"}, {"n": 46, "tl": "Innamaa anta mundhiru man yakhshaahaa"}, {"n": 47, "tl": "Ka'annahum yawma yarawnahaa lam yalbathoo illaa ashiyyatan aw duhaahaa"}]}
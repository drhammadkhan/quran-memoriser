{"ch": 79, "source": "transliteration.org", "verses": [{"n": 2, "tl": "Wa An-Nāzi`āti Gharqā an an"}, {"n": 3, "tl": "Wa An-Nāshiţāti Nashţā"}, {"n": 4, "tl": "Wa As-Sābiĥāti Sabĥā an"}, {"n": 5, "tl": "Fālssābiqāti Sabqā an"}, {"n": 6, "tl": "Fālmudabbirāti Amrā an"}, {"n": 7, "tl": "Yawma Tarjufu Ar-Rājifah u"}, {"n": 8, "tl": "Tatba`uhā Ar-Rādifah u"}, {"n": 9, "tl": "Qulūbun Yawma'idhin Wājifah un"}, {"n": 10, "tl": "'Abşāruhā Khāshi`ah un"}, {"n": 13, "tl": "Qālū Tilka Idhāan Karratun Khāsirahun"}, {"n": 14, "tl": "Fa'innamā Hiya Zajratun Wāĥidahun"}, {"n": 15, "tl": "Fa'idhā Hum Bis-Sāhirahi"}, {"n": 18, "tl": "Adh /hab Ilá Fir`awna Innahu Ţaghá"}, {"n": 19, "tl": "Faqul Hal Laka Ilá 'An Tazakká"}, {"n": 20, "tl": "Wa 'Ahdiyaka 'Ilá Rabbika Fatakhshá"}, {"n": 22, "tl": "Fakadhdhaba Wa `Aşá"}, {"n": 23, "tl": "Th umma Adbara Yas`á"}, {"n": 24, "tl": "Faĥashara Fanādá"}, {"n": 25, "tl": "Faqāla 'Anā Rabbukumu Al-'A`lá"}, {"n": 26, "tl": "Fa'akhadhahu Allāhu Nakāla Al-'Ā kh irati Wa Al-'Ūlá"}, {"n": 27, "tl": "'Inna Fī Dhālika La`ibratan Liman Yakhshá"}, {"n": 28, "tl": "'A'antum Ashaddu Kh alqāan 'Ami As-Samā'u Banāhā"}, {"n": 30, "tl": "Wa 'Aghţasha Laylahā Wa 'Akhraja Đuĥāhā"}, {"n": 32, "tl": "'Akhraja Minhā Mā'ahā Wa Mar`āhā"}, {"n": 33, "tl": "Wa Al-Jibāla 'Arsāhā"}, {"n": 34, "tl": "Matā`āan L kum"}, {"n": 35, "tl": "Fa'idhā Jā'ati Aţ-Ţāmmatu Al-Kubrá"}, {"n": 36, "tl": "Yawma Yatadhakkaru Al Insānu Mā Sa`á"}, {"n": 37, "tl": "Wa Burrizati Al Jaĥīmu Liman Yará"}, {"n": 38, "tl": "Fa'ammā Man Ţaghá"}, {"n": 40, "tl": "Fa'inna Al Jaĥīma Hiya Al-Ma'wá"}, {"n": 41, "tl": "Wa 'Ammā Man Khāfa Maqāma Rabbihi Wa Nahá An-Nafsa `Ani Al-Hawá"}, {"n": 42, "tl": "Fa'inna Al-Jannata Hiya Al-Ma'wá"}, {"n": 43, "tl": "Yas'alūnaka `Ani As-Sā`ati 'Ayyāna Mursāhā"}, {"n": 46, "tl": "'Innamā Anta Mundhiru Man Yakhshāhā"}, {"n": 47, "tl": "Ka'annahum Yawma Yarawnahā Lam Yalbathū Illā `Ashīyatan 'Aw Đuĥāhā"}]}
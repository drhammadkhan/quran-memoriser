{"ch": 84, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Idhas-samaa'u inshaqqat"}, {"n": 3, "tl": "Wa adhinat lirabbihaa wa huqqat"}, {"n": 4, "tl": "Wa idhal-ardu muddat"}, {"n": 5, "tl": "Wa alqat maa feehaa wa takhallat"}, {"n": 6, "tl": "Wa adhinat lirabbihaa wa huqqat"}, {"n": 7, "tl": "Yaa ayyuhal-insaanu innaka kaadihun ilaa rabbika kadhan famulaaqeeh"}, {"n": 8, "tl": "Fa-ammaa man ootiya kitaabahu biyameenih"}, {"n": 9, "tl": "Fasawfa yuhaasabu hisaaban yaseeraa"}, {"n": 10, "tl": "Wa yanqalibu ilaa ahlihi masrooraa"}, {"n": 11, "tl": "Wa ammaa man ootiya kitaabahu waraa'a zahrih"}, {"n": 12, "tl": "Fasawfa yad'oo thubooraa"}, {"n": 13, "tl": "Wa yaslaa sa'eeraa"}, {"n": 14, "tl": "Innahu kaana fee ahlihi masrooraa"}, {"n": 15, "tl": "Innahu zanna an lan yahoor"}, {"n": 16, "tl": "Balaa inna rabbahu kaana bihi baseeraa"}, {"n": 17, "tl": "Falaa uqsimu bish-shafaq"}, {"n": 18, "tl": "Wal-layli wa maa wasaq"}, {"n": 19, "tl": "Wal-qamari idhat-tasaq"}, {"n": 20, "tl": "Latarkabunna tabaqan an tabaq"}, {"n": 21, "tl": "Famaa lahum laa yu'minoon"}, {"n": 22, "tl": "Wa idhaa quri'a alayhimul-qur'aanu laa yasjudoon"}, {"n": 23, "tl": "Balil-ladheena kafaroo yukadhdhiboon"}, {"n": 24, "tl": "Wallaahu a'lamu bimaa yoo'oon"}, {"n": 25, "tl": "Fabashshirhum bi-adhaabin aleem"}, {"n": 26, "tl": "Illal-ladheena aamanoo wa amilus-saalihaati lahum ajrun ghayru mamnoon"}]}
{"ch": 84, "source": "transliteration.org", "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "'Idhā As-Samā'u Anshaqqat"}, {"n": 3, "tl": "Wa 'Adhinat Lirabbihā Wa Ĥuqqat"}, {"n": 4, "tl": "Wa 'Idhā Al-'Arđu Muddat"}, {"n": 5, "tl": "Wa 'Alqat Mā Fīhā Wa Takhallat"}, {"n": 6, "tl": "Wa 'Adhinat Lirabbihā Wa Ĥuqqat"}, {"n": 7, "tl": "Yā 'Ayyuhā Al-'Insānu 'Innaka Kādiĥun 'Ilá Rabbika Kadĥāan Famulāqīhi"}, {"n": 8, "tl": "Fa'ammā Man 'Ūtiya Kitābahu Biyamīnihi"}, {"n": 9, "tl": "Fasawfa Yuĥāsabu Ĥisābāan Yasīrāan"}, {"n": 10, "tl": "Wa Yanqalibu 'Ilá 'Ahlihi Masrūrāan"}, {"n": 11, "tl": "Wa 'Ammā Man 'Ūtiya Kitābahu Warā'a Žahrihi"}, {"n": 12, "tl": "Fasawfa Yad`ū Thubūrāan"}, {"n": 13, "tl": "Wa Yaşlá Sa`īrāan"}, {"n": 14, "tl": "'Innahu Kāna Fī Ahlihi Masrūrāan"}, {"n": 15, "tl": "'Innahu Žanna 'An Lan Yaĥūra"}, {"n": 16, "tl": "Balá Inna Rabbahu Kāna Bihi Başīrāan"}, {"n": 17, "tl": "Falā 'Uqsimu Bish-Shafaqi"}, {"n": 18, "tl": "Wa Al-Layli Wa Mā Wasaqa"}, {"n": 19, "tl": "Wa Al-Qamari 'Idhā Attasaqa"}, {"n": 20, "tl": "Latarkabunna Ţabaqāan `An Ţabaqin"}, {"n": 21, "tl": "Famā Lahum Lā Yu'uminūna"}, {"n": 22, "tl": "Wa 'Idhā Quri'a `Alayhimu Al-Qur'ānu Lā Yasjudūna"}, {"n": 23, "tl": "Bali Al-Ladhīna Kafarū Yukadhdhibūna"}, {"n": 24, "tl": "Wa Allāhu 'A`lamu Bimā Yū`ūna"}, {"n": 25, "tl": "Fabashshirhum Bi`adhābin 'Alīmin"}, {"n": 26, "tl": "'Illā Al-Ladhīna 'Āmanū Wa `Amilū Aş-Şāliĥāti Lahum Ajrun Ghayru Mamnūnin"}]}
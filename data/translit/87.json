{"ch": 87, "source": "transliteration.org", "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Sabbiĥi Asma Rabbika Al-'A`lá"}, {"n": 3, "tl": "Al-Ladhī Khalaqa Fasawwá"}, {"n": 4, "tl": "Wa Al-Ladhī Qaddara Fahadá"}, {"n": 5, "tl": "Wa Al-Ladhī 'Akhraja Al-Mar`á"}, {"n": 6, "tl": "Faja`alahu Ghuthā'an 'Aĥwá"}, {"n": 7, "tl": "Sanuqri'uka Falā Tansá"}, {"n": 8, "tl": "'Illā Mā Shā'a Allāhu 'Innahu Ya`lamu Al-Jahra Wa Mā Yakhfá"}, {"n": 9, "tl": "Wa Nuyassiruka Lilyusrá"}, {"n": 10, "tl": "Fadhakkir 'In Nafa`ati Adh-Dhikrá"}, {"n": 11, "tl": "Sayadhdhakkaru Man Yakhshá"}, {"n": 12, "tl": "Wa Yatajannabuhā Al-'Ashqá"}, {"n": 13, "tl": "Al-Ladhī Yaşlá An-Nāra Al-Kubrá"}, {"n": 14, "tl": "Thumma Lā Yamūtu Fīhā Wa Lā Yaĥyā"}, {"n": 15, "tl": "Qad 'Aflaĥa Man Tazakká"}, {"n": 16, "tl": "Wa Dhakara Asma Rabbihi Faşallá"}, {"n": 17, "tl": "Bal Tu'uthirūna Al-Ĥayāata Ad-Dunyā"}, {"n": 18, "tl": "Wa Al-'Ākhiratu Khayrun Wa 'Abqá"}, {"n": 19, "tl": "'Inna Hādhā Lafī Aş-Şuĥufi Al-'Ūlá"}, {"n": 20, "tl": "Şuĥufi 'Ibrāhīma Wa Mūsá"}]}
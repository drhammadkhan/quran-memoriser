{"ch": 87, "verses": [{"n": 2, "tl": "Sabbiĥi Asma Rabbika Al-'A`lá"}, {"n": 3, "tl": "Al-Ladhī Kh alaqa Fasawwá"}, {"n": 4, "tl": "Wa Al-Ladhī Qaddara Fahadá"}, {"n": 5, "tl": "Wa Al-Ladhī 'Akhraja Al-Mar`á"}, {"n": 6, "tl": "Faja`alahu Gh uthā'an Aĥwá"}, {"n": 7, "tl": "Sanuqri'uka Falā Tansá"}, {"n": 8, "tl": "'Illā Mā Shā'a Allāhu Innahu Ya`lamu Al-Jahra Wa Mā Yakhfá"}, {"n": 9, "tl": "Wa Nuyassiruka Lilyusrá"}, {"n": 10, "tl": "Fadhakkir 'In Nafa`ati Adh-Dhikrá"}, {"n": 11, "tl": "Sayadhdhakkaru Man Yakhshá"}, {"n": 12, "tl": "Wa Yatajannabuhā Al-'Ashqá"}, {"n": 13, "tl": "Al-Ladhī Yaşlá An-Nāra Al-Kubrá"}, {"n": 15, "tl": "Qad 'Aflaĥa Man Tazakká"}, {"n": 16, "tl": "Wa Dhakara Asma Rabbihi Faşallá"}, {"n": 18, "tl": "Wa Al-'Ākhiratu Kh ayrun Wa 'Abqá"}, {"n": 19, "tl": "'Inna Hādhā Lafī Aş-Şuĥufi Al-'Ūlá"}, {"n": 20, "tl": "Şuĥufi Ibrāhīma Wa Mūsá"}]}
{"ch": 87, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Sabbihi isma rabbikal-a'laa"}, {"n": 3, "tl": "Al-ladhee khalaqa fasawwaa"}, {"n": 4, "tl": "Wal-ladhee qaddara fahadaa"}, {"n": 5, "tl": "Wal-ladhee akhrajal-mar'aa"}, {"n": 6, "tl": "Faja'alahu ghuthaa'an ahwaa"}, {"n": 7, "tl": "Sanuqri'uka falaa tansaa"}, {"n": 8, "tl": "Illaa maa shaa'a Allaahu innahu ya'lamul-jahra wa maa yakhfaa"}, {"n": 9, "tl": "Wa nuyassiruka lilyusraa"}, {"n": 10, "tl": "Fadhakkir in nafa'atidh-dhikraa"}, {"n": 11, "tl": "Sayadhdhakkaru man yakhshaa"}, {"n": 12, "tl": "Wa yatajannabuhal-ashqaa"}, {"n": 13, "tl": "Al-ladhee yaslan-naaral-kubraa"}, {"n": 14, "tl": "Thumma laa yamootu feehaa wa laa yahyaa"}, {"n": 15, "tl": "Qad aflaha man tazakkaa"}, {"n": 16, "tl": "Wa dhakara isma rabbihi fasallaa"}, {"n": 17, "tl": "Bal tu'thiroonal-hayaatad-dunyaa"}, {"n": 18, "tl": "Wal-aakhiratu khayrun wa abqaa"}, {"n": 19, "tl": "Inna haadhaa lafis-suhufil-oolaa"}, {"n": 20, "tl": "Suhufi ibraaheema wa moosaa"}]}
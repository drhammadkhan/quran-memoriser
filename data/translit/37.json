{"ch": 37, "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Wa Aş-Şāffāti Şaffāan"}, {"n": 3, "tl": "Fālzzājirāti Zajrāan"}, {"n": 4, "tl": "Fālttāliyāti Dhikrāan"}, {"n": 5, "tl": "'Inna 'Ilahakum Lawāĥidun"}, {"n": 6, "tl": "Rabbu As-Samāwāti Wa Al-'Arđi Wa Mā Baynahumā Wa Rabbu Al-Mashāriqi"}, {"n": 7, "tl": "'Innā Zayyannā As-Samā'a Ad-Dunyā Bizīnatin Al-Kawākib"}, {"n": 8, "tl": "Wa Ĥifžāan Min Kulli Shayţānin Māridin"}, {"n": 9, "tl": "Lā Yassamma`ūna 'Ilá Al-Mala'i Al-'A`lá Wa Yuqdhafūna Min Kulli Jānibin"}, {"n": 10, "tl": "Duĥūrāan Wa Lahum `Adhābun Wa Aşibun"}, {"n": 11, "tl": "'Illā Man Khaţifa Al-Khaţfata Fa'atba`ahu Shihābun Thāqibunā"}, {"n": 12, "tl": "Fāstaftihim 'Ahum 'Ashaddu Khalqāan 'Am Man Khalaqnā 'Innā Khalaqnāhum Min Ţīnin Lāzibin"}, {"n": 13, "tl": "Bal `Ajibta Wa Yaskharūna"}, {"n": 14, "tl": "Wa 'Idhā Dhukkirū Lā Yadhkurūna"}, {"n": 15, "tl": "Wa 'Idhā Ra'awā 'Āyatan Yastaskhirūna"}, {"n": 16, "tl": "Wa Qālū 'In Hādhā 'Illā Siĥrun Mubīnun"}, {"n": 17, "tl": "'A'idhā Mitnā Wa Kunnā Turābāan Wa `Ižāmāan 'A'innā Lamab`ūthūna"}, {"n": 18, "tl": "'Awa'ābā'uunā Al-'Awwalūna"}, {"n": 19, "tl": "Qul Na`am Wa 'Antum Dākhirūna"}, {"n": 20, "tl": "Fa'innamā Hiya Zajratun Wāĥidatun Fa'idhā Hum Yanžurūna"}, {"n": 21, "tl": "Wa Qālū Yā Waylanā Hādhā Yawmu Ad-Dīni"}, {"n": 22, "tl": "Hādhā Yawmu Al-Faşli Al-Ladhī Kuntum Bihi Tukadhdhibūna"}, {"n": 23, "tl": "Aĥshurū Al-Ladhīna Žalamū Wa 'Azwājahum Wa Mā Kānū Ya`budūna"}, {"n": 24, "tl": "Min Dūni Allāhi Fāhdūhum 'Ilá Şirāţi Al-Jaĥīmi"}, {"n": 25, "tl": "Wa Qifūhum 'Innahum Mas'ūlūna"}, {"n": 26, "tl": "Mā Lakum Lā Tanāşarūna"}, {"n": 27, "tl": "Bal Humu Al-Yawma Mustaslimūna"}, {"n": 28, "tl": "Wa 'Aqbala Ba`đuhum `Alá Ba`đin Yatasā'alūna"}, {"n": 29, "tl": "Qālū 'Innakum Kuntum Ta'tūnanā `Ani Al-Yamīni"}, {"n": 30, "tl": "Qālū Bal Lam Takūnū Mu'uminīna"}, {"n": 31, "tl": "Wa Mā Kāna Lanā `Alaykum Min Sulţānin Bal Kuntum Qawmāan Ţāghīna"}, {"n": 32, "tl": "Faĥaqqa `Alaynā Qawlu Rabbinā 'Innā Ladhā'iqūna"}, {"n": 33, "tl": "Fa'aghwaynākum 'Innā Kunnā Ghāwīna"}, {"n": 34, "tl": "Fa'innahum Yawma'idhin Fī Al-`Adhābi Mushtarikūna"}, {"n": 35, "tl": "'Innā Kadhālika Naf`alu Bil-Mujrimīna"}, {"n": 36, "tl": "'Innahum Kānū 'Idhā Qīla Lahum Lā 'Ilāha 'Illā Al-Lahu Yastakbirūna"}, {"n": 37, "tl": "Wa Yaqūlūna 'A'innā Latārikū 'Ālihatinā Lishā`irin Majnūnin"}, {"n": 38, "tl": "Bal Jā'a Bil-Ĥaqqi Wa Şaddaqa Al-Mursalīna"}, {"n": 39, "tl": "'Innakum Ladhā'iqū Al-`Adhābi Al-'Alīmi"}, {"n": 40, "tl": "Wa Mā Tujzawna 'Illā Mā Kuntum Ta`malūna"}, {"n": 41, "tl": "'Illā `Ibāda Allāhi Al-Mukhlaşīna"}, {"n": 42, "tl": "'Ūlā'ika Lahum Rizqun Ma`lūmun"}, {"n": 43, "tl": "Fawākihu Wa Hum Mukramūna"}, {"n": 44, "tl": "Fī Jannāti An-Na`īmi"}, {"n": 45, "tl": "`Alá Sururin Mutaqābilīna"}, {"n": 46, "tl": "Yuţāfu `Alayhim Bika'sin Min Ma`īnin"}, {"n": 47, "tl": "Bayđā'a Ladhdhatin Lilshshāribīna"}, {"n": 48, "tl": "Lā Fīhā Ghawlun Wa Lā Hum `Anhā Yunzafūna"}, {"n": 49, "tl": "Wa `Indahum Qāşirātu Aţ-Ţarfi `Īnun"}, {"n": 50, "tl": "Ka'annahunna Bayđun Maknūnun"}, {"n": 51, "tl": "Fa'aqbala Ba`đuhum `Alá Ba`đin Yatasā'alūna"}, {"n": 52, "tl": "Qāla Qā'ilun Minhum 'Innī Kāna Lī Qarīnun"}, {"n": 53, "tl": "Yaqūlu 'A'innaka Lamina Al-Muşaddiqīna"}, {"n": 54, "tl": "'A'idhā Mitnā Wa Kunnā Turābāan Wa `Ižāmāan 'A'innā Lamadīnūna"}, {"n": 55, "tl": "Qāla Hal 'Antum Muţţali`ūna"}, {"n": 56, "tl": "Fāţţala`a Fara'āhu Fī Sawā'i Al-Jaĥīmi"}, {"n": 57, "tl": "Qāla Ta-Allāhi 'In Kidta Laturdīni"}, {"n": 58, "tl": "Wa Lawlā Ni`matu Rabbī Lakuntu Mina Al-Muĥđarīna"}, {"n": 59, "tl": "'Afamā Naĥnu Bimayyitīna"}, {"n": 60, "tl": "'Illā Mawtatanā Al-'Ūlá Wa Mā Naĥnu Bimu`adhdhabīna"}, {"n": 61, "tl": "'Inna Hādhā Lahuwa Al-Fawzu Al-`Ažīmu"}, {"n": 62, "tl": "Limithli Hādhā Falya`mali Al-`Āmilūna"}, {"n": 63, "tl": "'Adhalika Khayrun Nuzulāan 'Am Shajaratu Az-Zaqqūmi"}, {"n": 64, "tl": "'Innā Ja`alnāhā Fitnatan Lilžžālimīna"}, {"n": 65, "tl": "'Innahā Shajaratun Takhruju Fī 'Aşli Al-Jaĥīmi"}, {"n": 66, "tl": "Ţal`uhā Ka'annahu Ru'ūsu Ash-Shayāţīni"}, {"n": 67, "tl": "Fa'innahum La'ākilūna Minhā Famāli'ūna Minhā Al-Buţūna"}, {"n": 68, "tl": "Thumma 'Inna Lahum `Alayhā Lashawbāan Min Ĥamīmin"}, {"n": 69, "tl": "Thumma 'Inna Marji`ahum La'ilá Al-Jaĥīmi"}, {"n": 70, "tl": "'Innahum 'Alfawā 'Ābā'ahum Đāllīna"}, {"n": 71, "tl": "Fahum `Alá 'Āthārihim Yuhra`ūna"}, {"n": 72, "tl": "Wa Laqad Đalla Qablahum 'Aktharu Al-'Awwalīna"}, {"n": 73, "tl": "Wa Laqad 'Arsalnā Fīhim Mundhirīna"}, {"n": 74, "tl": "Fānžur Kayfa Kāna `Āqibatu Al-Mundharīna"}, {"n": 75, "tl": "'Illā `Ibāda Allāhi Al-Mukhlaşīna"}, {"n": 76, "tl": "Wa Laqad Nādānā Nūĥun Falani`ma Al-Mujībūna"}, {"n": 77, "tl": "Wa Najjaynāhu Wa 'Ahlahu Mina Al-Karbi Al-`Ažīmi"}, {"n": 78, "tl": "Wa Ja`alnā Dhurrīyatahu Humu Al-Bāqīna"}, {"n": 79, "tl": "Wa Taraknā `Alayhi Fī Al-'Ākhirīna"}, {"n": 80, "tl": "Salāmun `Alá Nūĥin Fī Al-`Ālamīna"}, {"n": 81, "tl": "'Innā Kadhālika Najzī Al-Muĥsinīna"}, {"n": 82, "tl": "'Innahu Min `Ibādinā Al-Mu'uminīna"}, {"n": 83, "tl": "Thumma 'Aghraqnā Al-'Ākharīna"}, {"n": 84, "tl": "Wa 'Inna Min Shī`atihi La'ibrāhīma"}, {"n": 85, "tl": "'Idh Jā'a Rabbahu Biqalbin Salīmin"}, {"n": 86, "tl": "'Idh Qāla Li'abīhi Wa Qawmihi Mādhā Ta`budūna"}, {"n": 87, "tl": "'A'ifkāan 'Ālihatan Dūna Allāhi Turīdūna"}, {"n": 88, "tl": "Famā Žannukum Birabbi Al-`Ālamīna"}, {"n": 89, "tl": "Fanažara Nažratan Fī An-Nujūmi"}, {"n": 90, "tl": "Faqāla 'Innī Saqīmun"}, {"n": 91, "tl": "Fatawallawā `Anhu Mudbirīna"}, {"n": 92, "tl": "Farāgha 'Ilá 'Ālihatihim Faqāla 'Alā Ta'kulūna"}, {"n": 93, "tl": "Mā Lakum Lā Tanţiqūna"}, {"n": 94, "tl": "Farāgha `Alayhim Đarbāan Bil-Yamīni"}, {"n": 95, "tl": "Fa'aqbalū 'Ilayhi Yaziffūna"}, {"n": 96, "tl": "Qāla 'Ata`budūna Mā Tanĥitūna"}, {"n": 97, "tl": "Wa Allāhu Khalaqakum Wa Mā Ta`malūna"}, {"n": 98, "tl": "Qālū Abnū Lahu Bunyānāan Fa'alqūhu Fī Al-Jaĥīmi"}, {"n": 99, "tl": "Fa'arādū Bihi Kaydāan Faja`alnāhumu Al-'Asfalīna"}, {"n": 100, "tl": "Wa Qāla 'Innī Dhāhibun 'Ilá Rabbī Sayahdīni"}, {"n": 101, "tl": "Rabbi Hab Lī Mina Aş-Şāliĥīna"}, {"n": 102, "tl": "Fabashsharnāhu Bighulāmin Ĥalīmin"}, {"n": 103, "tl": "Falammā Balagha Ma`ahu As-Sa`ya Qāla Yā Bunayya 'Innī 'Ará Fī Al-Manāmi 'Annī 'Adhbaĥuka Fānžur Mādhā Tará Qāla Yā 'Abati Af`al Mā Tu'umaru Satajidunī 'In Shā'a Allāhu Mina Aş-Şābirīna"}, {"n": 104, "tl": "Falammā 'Aslamā Wa Tallahu Liljabīni"}, {"n": 105, "tl": "Wa Nādaynāhu 'An Yā 'Ibrāhīmu"}, {"n": 106, "tl": "Qad Şaddaqta Ar-Ru'uyā 'Innā Kadhālika Najzī Al-Muĥsinīna"}, {"n": 107, "tl": "'Inna Hādhā Lahuwa Al-Balā'u Al-Mubīnu"}, {"n": 108, "tl": "Wa Fadaynāhu Bidhibĥin `Ažīmin"}, {"n": 109, "tl": "Wa Taraknā `Alayhi Fī Al-'Ākhirīna"}, {"n": 110, "tl": "Salāmun `Alá 'Ibrāhīma"}, {"n": 111, "tl": "Kadhālika Najzī Al-Muĥsinīna"}, {"n": 112, "tl": "'Innahu Min `Ibādinā Al-Mu'uminīna"}, {"n": 113, "tl": "Wa Bashsharnāhu Bi'isĥāqa Nabīyāan Mina Aş-Şāliĥīna"}, {"n": 114, "tl": "Wa Bāraknā `Alayhi Wa `Alá 'Isĥāqa Wa Min Dhurrīyatihimā Muĥsinun Wa Žālimun Linafsihi Mubīnun"}, {"n": 115, "tl": "Wa Laqad Manannā `Alá Mūsá Wa Hārūna"}, {"n": 116, "tl": "Wa Najjaynāhumā Wa Qawmahumā Mina Al-Karbi Al-`Ažīmi"}, {"n": 117, "tl": "Wa Naşarnāhum Fakānū Humu Al-Ghālibīna"}, {"n": 118, "tl": "Wa 'Ātaynāhumā Al-Kitāba Al-Mustabīna"}, {"n": 119, "tl": "Wa Hadaynāhumā Aş-Şirāţa Al-Mustaqīma"}, {"n": 120, "tl": "Wa Taraknā `Alayhimā Fī Al-'Ākhirīna"}, {"n": 121, "tl": "Salāmun `Alá Mūsá Wa Hārūna"}, {"n": 122, "tl": "'Innā Kadhālika Najzī Al-Muĥsinīna"}, {"n": 123, "tl": "'Innahumā Min `Ibādinā Al-Mu'uminīna"}, {"n": 124, "tl": "Wa 'Inna 'Ilyāsa Lamina Al-Mursalīna"}, {"n": 125, "tl": "'Idh Qāla Liqawmihi 'Alā Tattaqūna"}, {"n": 126, "tl": "'Atad`ūna Ba`lāan Wa Tadharūna 'Aĥsana Al-Khāliqīna"}, {"n": 127, "tl": "Al-Laha Rabbakum Wa Rabba 'Ābā'ikumu Al-'Awwalīna"}, {"n": 128, "tl": "Fakadhdhabūhu Fa'innahum Lamuĥđarūna"}, {"n": 129, "tl": "'Illā `Ibāda Allāhi Al-Mukhlaşīna"}, {"n": 130, "tl": "Wa Taraknā `Alayhi Fī Al-'Ākhirīna"}, {"n": 131, "tl": "Salāmun `Alá 'Il Yā-Sīn"}, {"n": 132, "tl": "'Innā Kadhālika Najzī Al-Muĥsinīna"}, {"n": 133, "tl": "'Innahu Min `Ibādinā Al-Mu'uminīna"}, {"n": 134, "tl": "Wa 'Inna Lūţāan Lamina Al-Mursalīna"}, {"n": 135, "tl": "'Idh Najjaynāhu Wa 'Ahlahu 'Ajma`īna"}, {"n": 136, "tl": "'Illā `Ajūzāan Fī Al-Ghābirīna"}, {"n": 137, "tl": "Thumma Dammarnā Al-'Ākharīna"}, {"n": 138, "tl": "Wa 'Innakum Latamurrūna `Alayhim Muşbiĥīna"}, {"n": 139, "tl": "Wa Bil-Layli 'Afalā Ta`qilūna"}, {"n": 140, "tl": "Wa 'Inna Yūnis Lamina Al-Mursalīna"}, {"n": 141, "tl": "'Idh 'Abaqa 'Ilá Al-Fulki Al-Mashĥūni"}, {"n": 142, "tl": "Fasāhama Fakāna Mina Al-Mudĥađīna"}, {"n": 143, "tl": "Fāltaqamahu Al-Ĥūtu Wa Huwa Mulīmun"}, {"n": 144, "tl": "Falawlā 'Annahu Kāna Mina Al-Musabbiĥīna"}, {"n": 145, "tl": "Lalabitha Fī Baţnihi 'Ilá Yawmi Yub`athūna"}, {"n": 146, "tl": "Fanabadhnāhu Bil-`Arā'i Wa Huwa Saqīmun"}, {"n": 147, "tl": "Wa 'Anbatnā `Alayhi Shajaratan Min Yaqţīnin"}, {"n": 148, "tl": "Wa 'Arsalnāhu 'Ilá Miā'ati 'Alfin 'Aw Yazīdūna"}, {"n": 149, "tl": "Fa'āmanū Famatta`nāhum 'Ilá Ĥīnin"}, {"n": 150, "tl": "Fāstaftihim 'Alirabbika Al-Banātu Wa Lahumu Al-Banūna"}, {"n": 151, "tl": "'Am Khalaqnā Al-Malā'ikata 'Ināthāan Wa Hum Shāhidūna"}, {"n": 152, "tl": "'Alā 'Innahum Min 'Ifkihim Layaqūlūna"}, {"n": 153, "tl": "Walada Allāhu Wa 'Innahum Lakādhibūna"}, {"n": 154, "tl": "'Āşţafá Al-Banāti `Alá Al-Banīna"}, {"n": 155, "tl": "Mā Lakum Kayfa Taĥkumūna"}, {"n": 156, "tl": "'Afalā Tadhakkarūn"}, {"n": 157, "tl": "'Am Lakum Sulţānun Mubīnun"}, {"n": 158, "tl": "Fa'tū Bikitābikum 'In Kuntum Şādiqīna"}, {"n": 159, "tl": "Wa Ja`alū Baynahu Wa Bayna Al-Jinnati Nasabāan Wa Laqad `Alimati Al-Jinnatu 'Innahum Lamuĥđarūna"}, {"n": 160, "tl": "Subĥāna Allāhi `Ammā Yaşifūna"}, {"n": 161, "tl": "'Illā `Ibāda Allāhi Al-Mukhlaşīna"}, {"n": 162, "tl": "Fa'innakum Wa Mā Ta`budūna"}, {"n": 163, "tl": "Mā 'Antum `Alayhi Bifātinīna"}, {"n": 164, "tl": "'Illā Man Huwa Şālī Al-Jaĥīmi"}, {"n": 165, "tl": "Wa Mā Minnā 'Illā Lahu Maqāmun Ma`lūmun"}, {"n": 166, "tl": "Wa 'Innā Lanaĥnu Aş-Şāffūna"}, {"n": 167, "tl": "Wa 'Innā Lanaĥnu Al-Musabbiĥūna"}, {"n": 168, "tl": "Wa 'In Kānū Layaqūlūna"}, {"n": 169, "tl": "Law 'Anna `Indanā Dhikrāan Mina Al-'Awwalīna"}, {"n": 170, "tl": "Lakunnā `Ibāda Allāhi Al-Mukhlaşīna"}, {"n": 171, "tl": "Fakafarū Bihi Fasawfa Ya`lamūna"}, {"n": 172, "tl": "Wa Laqad Sabaqat Kalimatunā Li`ibādinā Al-Mursalīn"}, {"n": 173, "tl": "'Innahum Lahumu Al-Manşūrūna"}, {"n": 174, "tl": "Wa 'Inna Jundanā Lahumu Al-Ghālibūna"}, {"n": 175, "tl": "Fatawalla `Anhum Ĥattá Ĥīnin"}, {"n": 176, "tl": "Wa 'Abşirhum Fasawfa Yubşirūna"}, {"n": 177, "tl": "'Afabi`adhābinā Yasta`jilūna"}, {"n": 178, "tl": "Fa'idhā Nazala Bisāĥatihim Fasā'a Şabāĥu Al-Mundharīna"}, {"n": 179, "tl": "Wa Tawalla `Anhum Ĥattá Ĥīnin"}, {"n": 180, "tl": "Wa 'Abşir Fasawfa Yubşirūna"}, {"n": 181, "tl": "Subĥāna Rabbika Rabbi Al-`Izzati `Ammā Yaşifūna"}, {"n": 182, "tl": "Wa Salāmun `Alá Al-Mursalīna"}, {"n": 183, "tl": "Wa Al-Ĥamdu Lillāh Rabbi Al-`Ālamīna"}]}
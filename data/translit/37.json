{"ch": 37, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Was-saaffaati saffaa"}, {"n": 3, "tl": "Faz-zaajiraati zajraa"}, {"n": 4, "tl": "Fat-taaliyaati dhikraa"}, {"n": 5, "tl": "Inna ilahakum lawaahid"}, {"n": 6, "tl": "Rabbus-samaawaati wal-ardi wa maa baynahumaa wa rabbul-mashaariq"}, {"n": 7, "tl": "Innaa zayyannas-samaa'ad-dunyaa bizeenatin al-kawaakib"}, {"n": 8, "tl": "Wa hifzan min kulli shaytaanin maarid"}, {"n": 9, "tl": "Laa yassamma'oona ilal-mala'il-a'laa wa yuqdhafoona min kulli jaanib"}, {"n": 10, "tl": "Duhooran wa lahum adhaabun wasib"}, {"n": 11, "tl": "Illaa man khatifal-khatfata fa-atba'ahu shihaabun thaaqibunaa"}, {"n": 12, "tl": "Fastaftihim ahum ashaddu khalqan am man khalaqnaa innaa khalaqnaahum min teenin laazib"}, {"n": 13, "tl": "Bal ajibta wa yaskharoon"}, {"n": 14, "tl": "Wa idhaa dhukkiroo laa yadhkuroon"}, {"n": 15, "tl": "Wa idhaa ra'aw aayatan yastaskhiroon"}, {"n": 16, "tl": "Wa qaaloo in haadhaa illaa sihrun mubeen"}, {"n": 17, "tl": "A'idhaa mitnaa wa kunnaa turaaban wa izaaman a'innaa lamab'oothoon"}, {"n": 18, "tl": "Awa'aabaa'uunal-awwaloon"}, {"n": 19, "tl": "Qul na'am wa antum daakhiroon"}, {"n": 20, "tl": "Fa-innamaa hiya zajratun waahidatun fa-idhaa hum yanzuroon"}, {"n": 21, "tl": "Wa qaaloo yaa waylanaa haadhaa yawmud-deen"}, {"n": 22, "tl": "Haadhaa yawmul-faslil-ladhee kuntum bihi tukadhdhiboon"}, {"n": 23, "tl": "Uhshurul-ladheena zalamoo wa azwaajahum wa maa kaanoo ya'budoon"}, {"n": 24, "tl": "Min doonillaahi fahdoohum ilaa siraatil-jaheem"}, {"n": 25, "tl": "Wa qifoohum innahum mas'ooloon"}, {"n": 26, "tl": "Maa lakum laa tanaasaroon"}, {"n": 27, "tl": "Bal humul-yawma mustaslimoon"}, {"n": 28, "tl": "Wa aqbala ba'duhum alaa ba'din yatasaa'aloon"}, {"n": 29, "tl": "Qaaloo innakum kuntum ta'toonanaa anil-yameen"}, {"n": 30, "tl": "Qaaloo bal lam takoonoo mu'mineen"}, {"n": 31, "tl": "Wa maa kaana lanaa alaykum min sultaanin bal kuntum qawman taagheen"}, {"n": 32, "tl": "Fahaqqa alaynaa qawlu rabbinaa innaa ladhaa'iqoon"}, {"n": 33, "tl": "Fa-aghwaynaakum innaa kunnaa ghaaween"}, {"n": 34, "tl": "Fa-innahum yawma'idhin fil-adhaabi mushtarikoon"}, {"n": 35, "tl": "Innaa kadhaalika naf'alu bil-mujrimeen"}, {"n": 36, "tl": "Innahum kaanoo idhaa qeela lahum laa ilaaha illaa Allaahu yastakbiroon"}, {"n": 37, "tl": "Wa yaqooloona a'innaa lataarikoo aalihatinaa lishaa'irin majnoon"}, {"n": 38, "tl": "Bal jaa'a bil-haqqi wa saddaqal-mursaleen"}, {"n": 39, "tl": "Innakum ladhaa'iqul-adhaabil-aleem"}, {"n": 40, "tl": "Wa maa tujzawna illaa maa kuntum ta'maloon"}, {"n": 41, "tl": "Illaa ibaada Allaahil-mukhlaseen"}, {"n": 42, "tl": "Ulaa'ika lahum rizqun ma'loom"}, {"n": 43, "tl": "Fawaakihu wa hum mukramoon"}, {"n": 44, "tl": "Fee jannaatin-na'eem"}, {"n": 45, "tl": "Alaa sururin mutaqaabileen"}, {"n": 46, "tl": "Yutaafu alayhim bika'sin min ma'een"}, {"n": 47, "tl": "Baydaa'a ladhdhatin lish-shaaribeen"}, {"n": 48, "tl": "Laa feehaa ghawlun wa laa hum anhaa yunzafoon"}, {"n": 49, "tl": "Wa indahum qaasiraatut-tarfi een"}, {"n": 50, "tl": "Ka'annahunna baydun maknoon"}, {"n": 51, "tl": "Fa-aqbala ba'duhum alaa ba'din yatasaa'aloon"}, {"n": 52, "tl": "Qaala qaa'ilun minhum innee kaana lee qareen"}, {"n": 53, "tl": "Yaqoolu a'innaka laminal-musaddiqeen"}, {"n": 54, "tl": "A'idhaa mitnaa wa kunnaa turaaban wa izaaman a'innaa lamadeenoon"}, {"n": 55, "tl": "Qaala hal antum muttali'oon"}, {"n": 56, "tl": "Fattala'a fara'aahu fee sawaa'il-jaheem"}, {"n": 57, "tl": "Qaala ta-Allaahi in kidta laturdeen"}, {"n": 58, "tl": "Wa lawlaa ni'matu rabbee lakuntu minal-muhdareen"}, {"n": 59, "tl": "Afamaa nahnu bimayyiteen"}, {"n": 60, "tl": "Illaa mawtatanal-oolaa wa maa nahnu bimu'adhdhabeen"}, {"n": 61, "tl": "Inna haadhaa lahuwal-fawzul-azeem"}, {"n": 62, "tl": "Limithli haadhaa falya'malil-aamiloon"}, {"n": 63, "tl": "Adhalika khayrun nuzulan am shajaratuz-zaqqoom"}, {"n": 64, "tl": "Innaa ja'alnaahaa fitnatan liz-zaalimeen"}, {"n": 65, "tl": "Innahaa shajaratun takhruju fee aslil-jaheem"}, {"n": 66, "tl": "Tal'uhaa ka'annahu ru'oosush-shayaateen"}, {"n": 67, "tl": "Fa-innahum la-aakiloona minhaa famaali'oona minhal-butoon"}, {"n": 68, "tl": "Thumma inna lahum alayhaa lashawban min hameem"}, {"n": 69, "tl": "Thumma inna marji'ahum la-ilal-jaheem"}, {"n": 70, "tl": "Innahum alfaw aabaa'ahum daalleen"}, {"n": 71, "tl": "Fahum alaa aathaarihim yuhra'oon"}, {"n": 72, "tl": "Wa laqad dalla qablahum aktharul-awwaleen"}, {"n": 73, "tl": "Wa laqad arsalnaa feehim mundhireen"}, {"n": 74, "tl": "Fanzur kayfa kaana aaqibatul-mundhareen"}, {"n": 75, "tl": "Illaa ibaada Allaahil-mukhlaseen"}, {"n": 76, "tl": "Wa laqad naadaanaa noohun falani'mal-mujeeboon"}, {"n": 77, "tl": "Wa najjaynaahu wa ahlahu minal-karbil-azeem"}, {"n": 78, "tl": "Wa ja'alnaa dhurriyyatahu humul-baaqeen"}, {"n": 79, "tl": "Wa taraknaa alayhi fil-aakhireen"}, {"n": 80, "tl": "Salaamun alaa noohin fil-aalameen"}, {"n": 81, "tl": "Innaa kadhaalika najzil-muhsineen"}, {"n": 82, "tl": "Innahu min ibaadinal-mu'mineen"}, {"n": 83, "tl": "Thumma aghraqnal-aakhareen"}, {"n": 84, "tl": "Wa inna min shee'atihi la-ibraaheem"}, {"n": 85, "tl": "Idh jaa'a rabbahu biqalbin saleem"}, {"n": 86, "tl": "Idh qaala li-abeehi wa qawmihi maadhaa ta'budoon"}, {"n": 87, "tl": "A'ifkan aalihatan doona Allaahi tureedoon"}, {"n": 88, "tl": "Famaa zannukum birabbil-aalameen"}, {"n": 89, "tl": "Fanazara nazratan fin-nujoom"}, {"n": 90, "tl": "Faqaala innee saqeem"}, {"n": 91, "tl": "Fatawallaw anhu mudbireen"}, {"n": 92, "tl": "Faraagha ilaa aalihatihim faqaala alaa ta'kuloon"}, {"n": 93, "tl": "Maa lakum laa tantiqoon"}, {"n": 94, "tl": "Faraagha alayhim darban bil-yameen"}, {"n": 95, "tl": "Fa-aqbaloo ilayhi yaziffoon"}, {"n": 96, "tl": "Qaala ata'budoona maa tanhitoon"}, {"n": 97, "tl": "Wallaahu khalaqakum wa maa ta'maloon"}, {"n": 98, "tl": "Qaalub-noo lahu bunyaanan fa-alqoohu fil-jaheem"}, {"n": 99, "tl": "Fa-araadoo bihi kaydan faja'alnaahumul-asfaleen"}, {"n": 100, "tl": "Wa qaala innee dhaahibun ilaa rabbee sayahdeen"}, {"n": 101, "tl": "Rabbi hab lee minas-saaliheen"}, {"n": 102, "tl": "Fabashsharnaahu bighulaamin haleem"}, {"n": 103, "tl": "Falammaa balagha ma'ahus-sa'ya qaala yaa bunayya innee araa fil-manaami annee adhbahuka fanzur maadhaa taraa qaala yaa abati if'al maa tu'maru satajidunee in shaa'a Allaahu minas-saabireen"}, {"n": 104, "tl": "Falammaa aslamaa wa tallahu liljabeen"}, {"n": 105, "tl": "Wa naadaynaahu an yaa ibraaheem"}, {"n": 106, "tl": "Qad saddaqtar-ru'yaa innaa kadhaalika najzil-muhsineen"}, {"n": 107, "tl": "Inna haadhaa lahuwal-balaa'ul-mubeen"}, {"n": 108, "tl": "Wa fadaynaahu bidhibhin azeem"}, {"n": 109, "tl": "Wa taraknaa alayhi fil-aakhireen"}, {"n": 110, "tl": "Salaamun alaa ibraaheem"}, {"n": 111, "tl": "Kadhaalika najzil-muhsineen"}, {"n": 112, "tl": "Innahu min ibaadinal-mu'mineen"}, {"n": 113, "tl": "Wa bashsharnaahu bi-ishaaqa nabiyyan minas-saaliheen"}, {"n": 114, "tl": "Wa baaraknaa alayhi wa alaa ishaaqa wa min dhurriyyatihimaa muhsinun wa zaalimun linafsihi mubeen"}, {"n": 115, "tl": "Wa laqad manannaa alaa moosaa wa haaroon"}, {"n": 116, "tl": "Wa najjaynaahumaa wa qawmahumaa minal-karbil-azeem"}, {"n": 117, "tl": "Wa nasarnaahum fakaanoo humul-ghaalibeen"}, {"n": 118, "tl": "Wa aataynaahumal-kitaabal-mustabeen"}, {"n": 119, "tl": "Wa hadaynaahumas-siraatal-mustaqeem"}, {"n": 120, "tl": "Wa taraknaa alayhimaa fil-aakhireen"}, {"n": 121, "tl": "Salaamun alaa moosaa wa haaroon"}, {"n": 122, "tl": "Innaa kadhaalika najzil-muhsineen"}, {"n": 123, "tl": "Innahumaa min ibaadinal-mu'mineen"}, {"n": 124, "tl": "Wa inna ilyaasa laminal-mursaleen"}, {"n": 125, "tl": "Idh qaala liqawmihi alaa tattaqoon"}, {"n": 126, "tl": "Atad'oona ba'lan wa tadharoona ahsanal-khaaliqeen"}, {"n": 127, "tl": "Allaaha rabbakum wa rabba aabaa'ikumul-awwaleen"}, {"n": 128, "tl": "Fakadhdhaboohu fa-innahum lamuhdaroon"}, {"n": 129, "tl": "Illaa ibaada Allaahil-mukhlaseen"}, {"n": 130, "tl": "Wa taraknaa alayhi fil-aakhireen"}, {"n": 131, "tl": "Salaamun alaa il yaa-seen"}, {"n": 132, "tl": "Innaa kadhaalika najzil-muhsineen"}, {"n": 133, "tl": "Innahu min ibaadinal-mu'mineen"}, {"n": 134, "tl": "Wa inna lootan laminal-mursaleen"}, {"n": 135, "tl": "Idh najjaynaahu wa ahlahu ajma'een"}, {"n": 136, "tl": "Illaa ajoozan fil-ghaabireen"}, {"n": 137, "tl": "Thumma dammarnal-aakhareen"}, {"n": 138, "tl": "Wa innakum latamurroona alayhim musbiheen"}, {"n": 139, "tl": "Wa bil-layli afalaa ta'qiloon"}, {"n": 140, "tl": "Wa inna yoonis laminal-mursaleen"}, {"n": 141, "tl": "Idh abaqa ilal-fulkil-mashhoon"}, {"n": 142, "tl": "Fasaahama fakaana minal-mudhadeen"}, {"n": 143, "tl": "Faltaqamahul-hootu wa huwa muleem"}, {"n": 144, "tl": "Falawlaa annahu kaana minal-musabbiheen"}, {"n": 145, "tl": "Lalabitha fee batnihi ilaa yawmi yub'athoon"}, {"n": 146, "tl": "Fanabadhnaahu bil-araa'i wa huwa saqeem"}, {"n": 147, "tl": "Wa anbatnaa alayhi shajaratan min yaqteen"}, {"n": 148, "tl": "Wa arsalnaahu ilaa miaa'ati alfin aw yazeedoon"}, {"n": 149, "tl": "Fa-aamanoo famatta'naahum ilaa heen"}, {"n": 150, "tl": "Fastaftihim alirabbikal-banaatu wa lahumul-banoon"}, {"n": 151, "tl": "Am khalaqnal-malaa'ikata inaathan wa hum shaahidoon"}, {"n": 152, "tl": "Alaa innahum min ifkihim layaqooloon"}, {"n": 153, "tl": "Walada Allaahu wa innahum lakaadhiboon"}, {"n": 154, "tl": "Aastafal-banaati alal-baneen"}, {"n": 155, "tl": "Maa lakum kayfa tahkumoon"}, {"n": 156, "tl": "Afalaa tadhakkaroon"}, {"n": 157, "tl": "Am lakum sultaanun mubeen"}, {"n": 158, "tl": "Fa'too bikitaabikum in kuntum saadiqeen"}, {"n": 159, "tl": "Wa ja'aloo baynahu wa baynal-jinnati nasaban wa laqad alimatil-jinnatu innahum lamuhdaroon"}, {"n": 160, "tl": "Subhaanallaahi ammaa yasifoon"}, {"n": 161, "tl": "Illaa ibaada Allaahil-mukhlaseen"}, {"n": 162, "tl": "Fa-innakum wa maa ta'budoon"}, {"n": 163, "tl": "Maa antum alayhi bifaatineen"}, {"n": 164, "tl": "Illaa man huwa saalil-jaheem"}, {"n": 165, "tl": "Wa maa minnaa illaa lahu maqaamun ma'loom"}, {"n": 166, "tl": "Wa innaa lanahnus-saaffoon"}, {"n": 167, "tl": "Wa innaa lanahnul-musabbihoon"}, {"n": 168, "tl": "Wa in kaanoo layaqooloon"}, {"n": 169, "tl": "Law anna indanaa dhikran minal-awwaleen"}, {"n": 170, "tl": "Lakunnaa ibaada Allaahil-mukhlaseen"}, {"n": 171, "tl": "Fakafaroo bihi fasawfa ya'lamoon"}, {"n": 172, "tl": "Wa laqad sabaqat kalimatunaa li-ibaadinal-mursaleen"}, {"n": 173, "tl": "Innahum lahumul-mansooroon"}, {"n": 174, "tl": "Wa inna jundanaa lahumul-ghaaliboon"}, {"n": 175, "tl": "Fatawalla anhum hattaa heen"}, {"n": 176, "tl": "Wa absirhum fasawfa yubsiroon"}, {"n": 177, "tl": "Afabi'adhaabinaa yasta'jiloon"}, {"n": 178, "tl": "Fa-idhaa nazala bisaahatihim fasaa'a sabaahul-mundhareen"}, {"n": 179, "tl": "Wa tawalla anhum hattaa heen"}, {"n": 180, "tl": "Wa absir fasawfa yubsiroon"}, {"n": 181, "tl": "Subhaana rabbika rabbil-izzati ammaa yasifoon"}, {"n": 182, "tl": "Wa salaamun alal-mursaleen"}, {"n": 183, "tl": "Wal-hamdu Lillaahi rabbil-aalameen"}]}
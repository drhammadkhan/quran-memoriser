{"ch": 77, "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Wa Al-Mursalāti `Urfāan"}, {"n": 3, "tl": "Fāl`āşifāti `Aşfāan"}, {"n": 4, "tl": "Wa An-Nāshirāti Nashrāan"}, {"n": 5, "tl": "Fālfāriqāti Farqāan"}, {"n": 6, "tl": "Fālmulqiyāti Dhikrāan"}, {"n": 7, "tl": "`Udhrāan 'Aw Nudhrāan"}, {"n": 8, "tl": "'Innamā Tū`adūna Lawāqi`un"}, {"n": 9, "tl": "Fa'idhā An-Nujūmu Ţumisat"}, {"n": 10, "tl": "Wa 'Idhā As-Samā'u Furijat"}, {"n": 11, "tl": "Wa 'Idhā Al-Jibālu Nusifat"}, {"n": 12, "tl": "Wa 'Idhā Ar-Rusulu 'Uqqitat"}, {"n": 13, "tl": "L'ayyi Yawmin 'Ujjilat"}, {"n": 14, "tl": "Liyawmi Al-Faşli"}, {"n": 15, "tl": "Wa Mā 'Adrāka Mā Yawmu Al-Faşli"}, {"n": 16, "tl": "Waylun Yawma'idhin Lilmukadhdhibīna"}, {"n": 17, "tl": "'Alam Nuhliki Al-'Awwalīna"}, {"n": 18, "tl": "Thumma Nutbi`uhumu Al-'Ākhirīna"}, {"n": 19, "tl": "Kadhālika Naf`alu Bil-Mujrimīna"}, {"n": 20, "tl": "Waylun Yawma'idhin Lilmukadhdhibīna"}, {"n": 21, "tl": "'Alam Nakhluqkum Min Mā'in Mahīnin"}, {"n": 22, "tl": "Faja`alnāhu Fī Qarārin Makīnin"}, {"n": 23, "tl": "'Ilá Qadarin Ma`lūmin"}, {"n": 24, "tl": "Faqadarnā Fani`ma Al-Qādirūna"}, {"n": 25, "tl": "Waylun Yawma'idhin Lilmukadhdhibīna"}, {"n": 26, "tl": "'Alam Naj`ali Al-'Arđa Kifātāan"}, {"n": 27, "tl": "'Aĥyā'an Wa 'Amwātāan"}, {"n": 28, "tl": "Wa Ja`alnā Fīhā Rawāsiya Shāmikhātin Wa 'Asqaynākum Mā'an Furātāan"}, {"n": 29, "tl": "Waylun Yawma'idhin Lilmukadhdhibīna"}, {"n": 30, "tl": "Anţaliqū 'Ilá Mā Kuntum Bihi Tukadhdhibūna"}, {"n": 31, "tl": "Anţaliqū 'Ilá Žillin Dhī Thalāthi Shu`abin"}, {"n": 32, "tl": "Lā Žalīlin Wa Lā Yughnī Mina Al-Lahabi"}, {"n": 33, "tl": "'Innahā Tarmī Bishararin Kālqaşri"}, {"n": 34, "tl": "Ka'annahu Jimālatun Şufrun"}, {"n": 35, "tl": "Waylun Yawma'idhin Lilmukadhdhibīna"}, {"n": 36, "tl": "Hādhā Yawmu Lā Yanţiqūna"}, {"n": 37, "tl": "Wa Lā Yu'udhanu Lahum Faya`tadhirūna"}, {"n": 38, "tl": "Waylun Yawma'idhin Lilmukadhdhibīna"}, {"n": 39, "tl": "Hādhā Yawmu Al-Faşli Jama`nākum Wa Al-'Awwalīna"}, {"n": 40, "tl": "Fa'in Kāna Lakum Kaydun Fakīdūni"}, {"n": 41, "tl": "Waylun Yawma'idhin Lilmukadhdhibīna"}, {"n": 42, "tl": "'Inna Al-Muttaqīna Fī Žilālin Wa `Uyūnin"}, {"n": 43, "tl": "Wa Fawākiha Mimmā Yashtahūna"}, {"n": 44, "tl": "Kulū Wa Ashrabū Hanī'āan Bimā Kuntum Ta`malūna"}, {"n": 45, "tl": "'Innā Kadhālika Najzī Al-Muĥsinīna"}, {"n": 46, "tl": "Waylun Yawma'idhin Lilmukadhdhibīna"}, {"n": 47, "tl": "Kulū Wa Tamatta`ū Qalīlāan 'Innakum Mujrimūna"}, {"n": 48, "tl": "Waylun Yawma'idhin Lilmukadhdhibīna"}, {"n": 49, "tl": "Wa 'Idhā Qīla Lahumu Arka`ū Lā Yarka`ūna"}, {"n": 50, "tl": "Waylun Yawma'idhin Lilmukadhdhibīna"}, {"n": 51, "tl": "Fabi'ayyi Ĥadīthin Ba`dahu Yu'uminūna"}]}
{"ch": 77, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Wal-mursalaati urfaa"}, {"n": 3, "tl": "Fal-aasifaati asfaa"}, {"n": 4, "tl": "Wan-naashiraati nashraa"}, {"n": 5, "tl": "Fal-faariqaati farqaa"}, {"n": 6, "tl": "Fal-mulqiyaati dhikraa"}, {"n": 7, "tl": "Udhran aw nudhraa"}, {"n": 8, "tl": "Innamaa too'adoona lawaaqi"}, {"n": 9, "tl": "Fa-idhan-nujoomu tumisat"}, {"n": 10, "tl": "Wa idhas-samaa'u furijat"}, {"n": 11, "tl": "Wa idhal-jibaalu nusifat"}, {"n": 12, "tl": "Wa idhar-rusulu uqqitat"}, {"n": 13, "tl": "L'ayyi yawmin ujjilat"}, {"n": 14, "tl": "Liyawmil-fasl"}, {"n": 15, "tl": "Wa maa adraaka maa yawmul-fasl"}, {"n": 16, "tl": "Waylun yawma'idhin lilmukadhdhibeen"}, {"n": 17, "tl": "Alam nuhlikil-awwaleen"}, {"n": 18, "tl": "Thumma nutbi'uhumul-aakhireen"}, {"n": 19, "tl": "Kadhaalika naf'alu bil-mujrimeen"}, {"n": 20, "tl": "Waylun yawma'idhin lilmukadhdhibeen"}, {"n": 21, "tl": "Alam nakhluqkum min maa'in maheen"}, {"n": 22, "tl": "Faja'alnaahu fee qaraarin makeen"}, {"n": 23, "tl": "Ilaa qadarin ma'loom"}, {"n": 24, "tl": "Faqadarnaa fani'mal-qaadiroon"}, {"n": 25, "tl": "Waylun yawma'idhin lilmukadhdhibeen"}, {"n": 26, "tl": "Alam naj'alil-arda kifaataa"}, {"n": 27, "tl": "Ahyaa'an wa amwaataa"}, {"n": 28, "tl": "Wa ja'alnaa feehaa rawaasiya shaamikhaatin wa asqaynaakum maa'an furaataa"}, {"n": 29, "tl": "Waylun yawma'idhin lilmukadhdhibeen"}, {"n": 30, "tl": "Intaliqoo ilaa maa kuntum bihi tukadhdhiboon"}, {"n": 31, "tl": "Intaliqoo ilaa zillin dhee thalaathi shu'ab"}, {"n": 32, "tl": "Laa zaleelin wa laa yughnee minal-lahab"}, {"n": 33, "tl": "Innahaa tarmee bishararin kal-qasr"}, {"n": 34, "tl": "Ka'annahu jimaalatun sufr"}, {"n": 35, "tl": "Waylun yawma'idhin lilmukadhdhibeen"}, {"n": 36, "tl": "Haadhaa yawmu laa yantiqoon"}, {"n": 37, "tl": "Wa laa yu'udhanu lahum faya'tadhiroon"}, {"n": 38, "tl": "Waylun yawma'idhin lilmukadhdhibeen"}, {"n": 39, "tl": "Haadhaa yawmul-fasli jama'naakum wal-awwaleen"}, {"n": 40, "tl": "Fa-in kaana lakum kaydun fakeedoon"}, {"n": 41, "tl": "Waylun yawma'idhin lilmukadhdhibeen"}, {"n": 42, "tl": "Innal-muttaqeena fee zilaalin wa uyoon"}, {"n": 43, "tl": "Wa fawaakiha mimmaa yashtahoon"}, {"n": 44, "tl": "Kuloo washraboo hanee'an bimaa kuntum ta'maloon"}, {"n": 45, "tl": "Innaa kadhaalika najzil-muhsineen"}, {"n": 46, "tl": "Waylun yawma'idhin lilmukadhdhibeen"}, {"n": 47, "tl": "Kuloo wa tamatta'oo qaleelan innakum mujrimoon"}, {"n": 48, "tl": "Waylun yawma'idhin lilmukadhdhibeen"}, {"n": 49, "tl": "Wa idhaa qeela lahumu irka'oo laa yarka'oon"}, {"n": 50, "tl": "Waylun yawma'idhin lilmukadhdhibeen"}, {"n": 51, "tl": "Fabi'ayyi hadeethin ba'dahu yu'minoon"}]}
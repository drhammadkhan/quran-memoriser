{"ch": 88, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Hal ataaka hadeethul-ghaashiyah"}, {"n": 3, "tl": "Wujoohun yawma'idhin khaashi'ah"}, {"n": 4, "tl": "Aamilatun naasibah"}, {"n": 5, "tl": "Taslaa naaran haamiyah"}, {"n": 6, "tl": "Tusqaa min aynin aaniyah"}, {"n": 7, "tl": "Laysa lahum ta'aamun illaa min daree"}, {"n": 8, "tl": "Laa yusminu wa laa yughnee min joo"}, {"n": 9, "tl": "Wujoohun yawma'idhin naa'imah"}, {"n": 10, "tl": "Lisa'yihaa raadiyah"}, {"n": 11, "tl": "Fee jannatin aaliyah"}, {"n": 12, "tl": "Laa tasma'u feehaa laaghiyah"}, {"n": 13, "tl": "Feehaa aynun jaariyah"}, {"n": 14, "tl": "Feehaa sururun marfoo'ah"}, {"n": 15, "tl": "Wa akwaabun mawdoo'ah"}, {"n": 16, "tl": "Wa namaariqu masfoofah"}, {"n": 17, "tl": "Wa zaraabiyyu mabthoothah"}, {"n": 18, "tl": "Afalaa yanzuroona ilal-ibili kayfa khuliqat"}, {"n": 19, "tl": "Wa ilas-samaa'i kayfa rufi'at"}, {"n": 20, "tl": "Wa ilal-jibaali kayfa nusibat"}, {"n": 21, "tl": "Wa ilal-ardi kayfa sutihat"}, {"n": 22, "tl": "Fadhakkir innamaa anta mudhakkir"}, {"n": 23, "tl": "Lasta alayhim bimusaytir"}, {"n": 24, "tl": "Illaa man tawallaa wa kafar"}, {"n": 25, "tl": "Fayu'adhdhibuhu Allaahul-adhaabal-akbar"}, {"n": 26, "tl": "Inna ilaynaa eeaabahum"}, {"n": 27, "tl": "Thumma inna alaynaa hisaabahum"}]}
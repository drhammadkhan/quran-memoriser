{"ch": 74, "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Yā 'Ayyuhā Al-Muddaththiru"}, {"n": 3, "tl": "Qum Fa'andhir"}, {"n": 4, "tl": "Wa Rabbaka Fakabbir"}, {"n": 5, "tl": "Wa Thiyābaka Faţahhir"}, {"n": 6, "tl": "Wa Ar-Rujza Fāhjur"}, {"n": 7, "tl": "Wa Lā Tamnun Tastakthiru"}, {"n": 8, "tl": "Wa Lirabbika Fāşbir"}, {"n": 9, "tl": "Fa'idhā Nuqira Fī An-Nāqūri"}, {"n": 10, "tl": "Fadhālika Yawma'idhin Yawmun `Asīrun"}, {"n": 11, "tl": "`Alá Al-Kāfirīna Ghayru Yasīrin"}, {"n": 12, "tl": "Dharnī Wa Man Khalaqtu Waĥīdāan"}, {"n": 13, "tl": "Wa Ja`altu Lahu Mālāan Mamdūdāan"}, {"n": 14, "tl": "Wa Banīna Shuhūdāan"}, {"n": 15, "tl": "Wa Mahhadtu Lahu Tamhīdāan"}, {"n": 16, "tl": "Thumma Yaţma`u 'An 'Azīda"}, {"n": 17, "tl": "Kallā 'Innahu Kāna Li'yātinā `Anīdāan"}, {"n": 18, "tl": "Sa'urhiquhu Şa`ūdāan"}, {"n": 19, "tl": "'Innahu Fakkara Wa Qaddara"}, {"n": 20, "tl": "Faqutila Kayfa Qaddara"}, {"n": 21, "tl": "Thumma Qutila Kayfa Qaddara"}, {"n": 22, "tl": "Thumma Nažara"}, {"n": 23, "tl": "Thumma `Abasa Wa Basara"}, {"n": 24, "tl": "Thumma 'Adbara Wa Astakbara"}, {"n": 25, "tl": "Faqāla 'In Hādhā 'Illā Siĥrun Yu'utharu"}, {"n": 26, "tl": "'In Hādhā 'Illā Qawlu Al-Bashari"}, {"n": 27, "tl": "Sa'uşlīhi Saqara"}, {"n": 28, "tl": "Wa Mā 'Adrāka Mā Saqaru"}, {"n": 29, "tl": "Lā Tubqī Wa Lā Tadharu"}, {"n": 30, "tl": "Lawwāĥatun Lilbashari"}, {"n": 31, "tl": "`Alayhā Tis`ata `Ashara"}, {"n": 32, "tl": "Wa Mā Ja`alnā 'Aşĥāba An-Nāri 'Illā Malā'ikatan Wa Mā Ja`alnā `Iddatahum 'Illā Fitnatan Lilladhīna Kafarū Liyastayqina Al-Ladhīna 'Ūtū Al-Kitāba Wa Yazdāda Al-Ladhīna 'Āmanū 'Īmānāan Wa Lā Yartāba Al-Ladhīna 'Ūtū Al-Kitāba Wa Al-Mu'uminūna Wa Liyaqūla Al-Ladhīna Fī Qulūbihim Marađun Wa Al-Kāfirūna Mādhā 'Arāda Allāhu Bihadhā Mathalāan Kadhālika Yuđillu Allāhu Man Yashā'u Wa Yahdī Man Yashā'u Wa Mā Ya`lamu Junūda Rabbika 'Illā Huwa Wa Mā Hiya 'Illā Dhikrá Lilbashari"}, {"n": 33, "tl": "Kallā Wa Al-Qamari"}, {"n": 34, "tl": "Wa Al-Layli 'Idh 'Adbara"}, {"n": 35, "tl": "Wa Aş-Şubĥi 'Idhā 'Asfara"}, {"n": 36, "tl": "'Innahā La'iĥdá Al-Kubari"}, {"n": 37, "tl": "Nadhīrāan Lilbashari"}, {"n": 38, "tl": "Liman Shā'a Minkum 'An Yataqaddama 'Aw Yata'akhkhara"}, {"n": 39, "tl": "Kullu Nafsin Bimā Kasabat Rahīnahun"}, {"n": 40, "tl": "'Illā 'Aşĥāba Al-Yamīni"}, {"n": 41, "tl": "Fī Jannātin Yatasā'alūna"}, {"n": 42, "tl": "`Ani Al-Mujrimīna"}, {"n": 43, "tl": "Mā Salakakum Fī Saqara"}, {"n": 44, "tl": "Qālū Lam Naku Mina Al-Muşallīna"}, {"n": 45, "tl": "Wa Lam Naku Nuţ`imu Al-Miskīna"}, {"n": 46, "tl": "Wa Kunnā Nakhūđu Ma`a Al-Khā'iđīna"}, {"n": 47, "tl": "Wa Kunnā Nukadhdhibu Biyawmi Ad-Dīni"}, {"n": 48, "tl": "Ĥattá 'Atānā Al-Yaqīnu"}, {"n": 49, "tl": "Famā Tanfa`uhum Shafā`atu Ash-Shāfi`īna"}, {"n": 50, "tl": "Famā Lahum `Ani At-Tadhkirati Mu`riđīna"}, {"n": 51, "tl": "Ka'annahum Ĥumurun Mustanfirahun"}, {"n": 52, "tl": "Farrat Min Qaswarahin"}, {"n": 53, "tl": "Bal Yurīdu Kullu Amri'in Minhum 'An Yu'utá Şuĥufāan Munashsharahan"}, {"n": 54, "tl": "Kallā Bal Lā Yakhāfūna Al-'Ākhiraha"}, {"n": 55, "tl": "Kallā 'Innahu Tadhkirahun"}, {"n": 56, "tl": "Faman Shā'a Dhakarahu"}, {"n": 57, "tl": "Wa Mā Yadhkurūna 'Illā 'An Yashā'a Allāhu Huwa 'Ahlu At-Taqwá Wa 'Ahlu Al-Maghfirahi"}]}
{"ch": 74, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Yaa ayyuhal-muddaththir"}, {"n": 3, "tl": "Qum fa-andhir"}, {"n": 4, "tl": "Wa rabbaka fakabbir"}, {"n": 5, "tl": "Wa thiyaabaka fatahhir"}, {"n": 6, "tl": "War-rujza fahjur"}, {"n": 7, "tl": "Wa laa tamnun tastakthir"}, {"n": 8, "tl": "Wa lirabbika fasbir"}, {"n": 9, "tl": "Fa-idhaa nuqira fin-naaqoor"}, {"n": 10, "tl": "Fadhaalika yawma'idhin yawmun aseer"}, {"n": 11, "tl": "Alal-kaafireena ghayru yaseer"}, {"n": 12, "tl": "Dharnee wa man khalaqtu waheedaa"}, {"n": 13, "tl": "Wa ja'altu lahu maalan mamdoodaa"}, {"n": 14, "tl": "Wa baneena shuhoodaa"}, {"n": 15, "tl": "Wa mahhadtu lahu tamheedaa"}, {"n": 16, "tl": "Thumma yatma'u an azeed"}, {"n": 17, "tl": "Kallaa innahu kaana li'yaatinaa aneedaa"}, {"n": 18, "tl": "Sa'urhiquhu sa'oodaa"}, {"n": 19, "tl": "Innahu fakkara wa qaddar"}, {"n": 20, "tl": "Faqutila kayfa qaddar"}, {"n": 21, "tl": "Thumma qutila kayfa qaddar"}, {"n": 22, "tl": "Thumma nazar"}, {"n": 23, "tl": "Thumma abasa wa basar"}, {"n": 24, "tl": "Thumma adbara wastakbar"}, {"n": 25, "tl": "Faqaala in haadhaa illaa sihrun yu'thar"}, {"n": 26, "tl": "In haadhaa illaa qawlul-bashar"}, {"n": 27, "tl": "Sa'usleehi saqar"}, {"n": 28, "tl": "Wa maa adraaka maa saqar"}, {"n": 29, "tl": "Laa tubqee wa laa tadhar"}, {"n": 30, "tl": "Lawwaahatun lilbashar"}, {"n": 31, "tl": "Alayhaa tis'ata ashar"}, {"n": 32, "tl": "Wa maa ja'alnaa ashaaban-naari illaa malaa'ikatan wa maa ja'alnaa iddatahum illaa fitnatan lilladheena kafaroo liyastayqinal-ladheena ootul-kitaaba wa yazdaadal-ladheena aamanoo eemaanan wa laa yartaabal-ladheena ootul-kitaaba wal-mu'minoona wa liyaqoolal-ladheena fee quloobihim maradun wal-kaafiroona maadhaa araada Allaahu bihadhaa mathalan kadhaalika yudillu Allaahu man yashaa'u wa yahdee man yashaa'u wa maa ya'lamu junooda rabbika illaa huwa wa maa hiya illaa dhikraa lilbashar"}, {"n": 33, "tl": "Kallaa wal-qamar"}, {"n": 34, "tl": "Wal-layli idh adbar"}, {"n": 35, "tl": "Was-subhi idhaa asfar"}, {"n": 36, "tl": "Innahaa la-ihdal-kubar"}, {"n": 37, "tl": "Nadheeran lilbashar"}, {"n": 38, "tl": "Liman shaa'a minkum an yataqaddama aw yata'akhkhar"}, {"n": 39, "tl": "Kullu nafsin bimaa kasabat raheenah"}, {"n": 40, "tl": "Illaa ashaabal-yameen"}, {"n": 41, "tl": "Fee jannaatin yatasaa'aloon"}, {"n": 42, "tl": "Anil-mujrimeen"}, {"n": 43, "tl": "Maa salakakum fee saqar"}, {"n": 44, "tl": "Qaaloo lam naku minal-musalleen"}, {"n": 45, "tl": "Wa lam naku nut'imul-miskeen"}, {"n": 46, "tl": "Wa kunnaa nakhoodu ma'al-khaa'ideen"}, {"n": 47, "tl": "Wa kunnaa nukadhdhibu biyawmid-deen"}, {"n": 48, "tl": "Hattaa ataanal-yaqeen"}, {"n": 49, "tl": "Famaa tanfa'uhum shafaa'atush-shaafi'een"}, {"n": 50, "tl": "Famaa lahum anit-tadhkirati mu'rideen"}, {"n": 51, "tl": "Ka'annahum humurun mustanfirah"}, {"n": 52, "tl": "Farrat min qaswarah"}, {"n": 53, "tl": "Bal yureedu kullu imri'in minhum an yu'taa suhufan munashsharah"}, {"n": 54, "tl": "Kallaa bal laa yakhaafoonal-aakhirah"}, {"n": 55, "tl": "Kallaa innahu tadhkirah"}, {"n": 56, "tl": "Faman shaa'a dhakarah"}, {"n": 57, "tl": "Wa maa yadhkuroona illaa an yashaa'a Allaahu huwa ahlut-taqwaa wa ahlul-maghfirah"}]}
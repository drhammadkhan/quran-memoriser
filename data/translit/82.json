{"ch": 82, "verses": [{"n": 2, "tl": "'Idhā As-Samā'u A nfaţarat"}, {"n": 3, "tl": "Wa 'Idhā Al-Kawākibu A ntatharat"}, {"n": 4, "tl": "Wa 'Idhā Al-Biĥāru Fujjirat"}, {"n": 5, "tl": "Wa 'Idhā Al-Qubūru Bu`thirat"}, {"n": 6, "tl": "`Alimat Nafsun Mā Qaddamat Wa 'Akhkharat"}, {"n": 7, "tl": "Yā 'Ayyuhā Al-'Insānu Mā Gharraka Birabbika Al-Karīmi"}, {"n": 9, "tl": "Fī 'Ayyi Şūratin Mā Shā'a Rakkabaka"}, {"n": 10, "tl": "Kallā Bal Tukadhdhibūna Bid-Dīni"}, {"n": 11, "tl": "Wa 'Inna `Alaykum Laĥāfižīna"}, {"n": 12, "tl": "Kirāmāan Kātibīna"}, {"n": 13, "tl": "Ya`lamūna Mā Taf`alūna"}, {"n": 15, "tl": "Wa 'Inna Al-Fujjāra Lafī Jaĥīmin"}, {"n": 16, "tl": "Yaşlawnahā Yawma Ad-Dīni"}, {"n": 17, "tl": "Wa Mā Hum `Anhā Bighā'ibīna"}, {"n": 20, "tl": "Yawma Lā Tamliku Nafsun Linafsin Shay'āan Wa Al-'Amru Yawma'idhin Lillāhi"}]}
{"ch": 82, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Idhas-samaa'u infatarat"}, {"n": 3, "tl": "Wa idhal-kawaakibu intatharat"}, {"n": 4, "tl": "Wa idhal-bihaaru fujjirat"}, {"n": 5, "tl": "Wa idhal-qubooru bu'thirat"}, {"n": 6, "tl": "Alimat nafsun maa qaddamat wa akhkharat"}, {"n": 7, "tl": "Yaa ayyuhal-insaanu maa gharraka birabbikal-kareem"}, {"n": 8, "tl": "Al-ladhee khalaqaka fasawwaaka fa-adalak"}, {"n": 9, "tl": "Fee ayyi sooratin maa shaa'a rakkabak"}, {"n": 10, "tl": "Kallaa bal tukadhdhiboona bid-deen"}, {"n": 11, "tl": "Wa inna alaykum lahaafizeen"}, {"n": 12, "tl": "Kiraaman kaatibeen"}, {"n": 13, "tl": "Ya'lamoona maa taf'aloon"}, {"n": 14, "tl": "Innal-abraara lafee na'eem"}, {"n": 15, "tl": "Wa innal-fujjaara lafee jaheem"}, {"n": 16, "tl": "Yaslawnahaa yawmad-deen"}, {"n": 17, "tl": "Wa maa hum anhaa bighaa'ibeen"}, {"n": 18, "tl": "Wa maa adraaka maa yawmud-deen"}, {"n": 19, "tl": "Thumma maa adraaka maa yawmud-deen"}, {"n": 20, "tl": "Yawma laa tamliku nafsun linafsin shay'an wal-amru yawma'idhin Lillaah"}]}
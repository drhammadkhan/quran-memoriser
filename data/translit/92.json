{"ch": 92, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Wal-layli idhaa yaghshaa"}, {"n": 3, "tl": "Wan-nahaari idhaa tajallaa"}, {"n": 4, "tl": "Wa maa khalaqadh-dhakara wal-unthaa"}, {"n": 5, "tl": "Inna sa'yakum lashattaa"}, {"n": 6, "tl": "Fa-ammaa man a'taa wattaqaa"}, {"n": 7, "tl": "Wa saddaqa bil-husnaa"}, {"n": 8, "tl": "Fasanuyassiruhu lilyusraa"}, {"n": 9, "tl": "Wa ammaa man bakhila wastaghnaa"}, {"n": 10, "tl": "Wa kadhdhaba bil-husnaa"}, {"n": 11, "tl": "Fasanuyassiruhu lil-usraa"}, {"n": 12, "tl": "Wa maa yughnee anhu maaluhu idhaa taraddaa"}, {"n": 13, "tl": "Inna alaynaa lalhudaa"}, {"n": 14, "tl": "Wa inna lanaa lal-aakhirata wal-oolaa"}, {"n": 15, "tl": "Fa-andhartukum naaran talazzaa"}, {"n": 16, "tl": "Laa yaslaahaa illal-ashqaa"}, {"n": 17, "tl": "Al-ladhee kadhdhaba wa tawallaa"}, {"n": 18, "tl": "Wa sayujannabuhal-atqaa"}, {"n": 19, "tl": "Al-ladhee yu'tee maalahu yatazakkaa"}, {"n": 20, "tl": "Wa maa li'hadin indahu min ni'matin tujzaa"}, {"n": 21, "tl": "Illab-tighaa'a wajhi rabbihil-a'laa"}, {"n": 22, "tl": "Wa lasawfa yardaa"}]}
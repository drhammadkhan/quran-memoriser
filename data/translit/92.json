{"ch": 92, "source": "transliteration.org", "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Wa Al-Layli 'Idhā Yaghshá"}, {"n": 3, "tl": "Wa An-Nahāri 'Idhā Tajallá"}, {"n": 4, "tl": "Wa Mā Khalaqa Adh-Dhakara Wa Al-'Unthá"}, {"n": 5, "tl": "'Inna Sa`yakum Lashattá"}, {"n": 6, "tl": "Fa'ammā Man 'A`ţá Wa Attaqá"}, {"n": 7, "tl": "Wa Şaddaqa Bil-Ĥusná"}, {"n": 8, "tl": "Fasanuyassiruhu Lilyusrá"}, {"n": 9, "tl": "Wa 'Ammā Man Bakhila Wa Astaghná"}, {"n": 10, "tl": "Wa Kadhdhaba Bil-Ĥusná"}, {"n": 11, "tl": "Fasanuyassiruhu Lil`usrá"}, {"n": 12, "tl": "Wa Mā Yughnī `Anhu Māluhu Idhā Taraddá"}, {"n": 13, "tl": "'Inna `Alaynā Lalhudá"}, {"n": 14, "tl": "Wa 'Inna Lanā Lal'ākhirata Wa Al-'Ūlá"}, {"n": 15, "tl": "Fa'andhartukum Nārāan Talažžá"}, {"n": 16, "tl": "Lā Yaşlāhā 'Illā Al-'Ashqá"}, {"n": 17, "tl": "Al-Ladhī Kadhdhaba Wa Tawallá"}, {"n": 18, "tl": "Wa Sayujannabuhā Al-'Atqá"}, {"n": 19, "tl": "Al-Ladhī Yu'utī Mālahu Yatazakká"}, {"n": 20, "tl": "Wa Mā Li'ĥadin `Indahu Min Ni`matin Tujzá"}, {"n": 21, "tl": "'Illā Abtighā'a Wajhi Rabbihi Al-'A`lá"}, {"n": 22, "tl": "Wa Lasawfa Yarđá"}]}
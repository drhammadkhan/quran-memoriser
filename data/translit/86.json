{"ch": 86, "source": "transliteration.org", "verses": [{"n": 2, "tl": "Wa As-Samā'i Wa Aţ-Ţāriqi"}, {"n": 4, "tl": "An-Najmu A th-Thāqibu"}, {"n": 5, "tl": "'In Kullu Nafsin Lammā `Alayhā Ĥāfižun"}, {"n": 6, "tl": "Falyanžuri Al-'Insānu Mimma Khuliqa"}, {"n": 7, "tl": "Kh uliqa Min Mā'in Dāfiqin"}, {"n": 8, "tl": "Yakhruju Min Bayni Aş-Şulbi Wa At-Tarā'ibi"}, {"n": 9, "tl": "'Innahu `Alá Raj`ihi Laqādirun"}, {"n": 10, "tl": "Yawma Tublá As-Sarā'iru"}, {"n": 11, "tl": "Famā Lahu Min Qūwatin Wa Lā Nāşirin"}, {"n": 12, "tl": "Wa As-Samā'i Dhāti Ar-Raj`i"}, {"n": 13, "tl": "Wa Al-'Arđi Dhāti Aş-Şad`i"}, {"n": 14, "tl": "'Innahu Laqawlun Faşlun"}, {"n": 15, "tl": "Wa Mā Huwa Bil-Hazli"}, {"n": 16, "tl": "'Innahum Yakīdūna Kaydāan"}, {"n": 17, "tl": "Wa 'Akīdu Kaydāan"}, {"n": 18, "tl": "Famahhili Al-Kāfirīna Amhilhum Ruwaydāan"}]}
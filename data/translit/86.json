{"ch": 86, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Was-samaa'i wat-taariq"}, {"n": 3, "tl": "Wa maa adraaka mat-taariq"}, {"n": 4, "tl": "An-najmuth-thaaqib"}, {"n": 5, "tl": "In kullu nafsin lammaa alayhaa haafiz"}, {"n": 6, "tl": "Falyanzuril-insaanu mimma khuliq"}, {"n": 7, "tl": "Khuliqa min maa'in daafiq"}, {"n": 8, "tl": "Yakhruju min baynis-sulbi wat-taraa'ib"}, {"n": 9, "tl": "Innahu alaa raj'ihi laqaadir"}, {"n": 10, "tl": "Yawma tublas-saraa'ir"}, {"n": 11, "tl": "Famaa lahu min quwwatin wa laa naasir"}, {"n": 12, "tl": "Was-samaa'i dhaatir-raj"}, {"n": 13, "tl": "Wal-ardi dhaatis-sad"}, {"n": 14, "tl": "Innahu laqawlun fasl"}, {"n": 15, "tl": "Wa maa huwa bil-hazl"}, {"n": 16, "tl": "Innahum yakeedoona kaydaa"}, {"n": 17, "tl": "Wa akeedu kaydaa"}, {"n": 18, "tl": "Famahhilil-kaafireena amhilhum ruwaydaa"}]}
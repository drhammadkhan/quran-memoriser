{"ch": 93, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Wad-duhaa"}, {"n": 3, "tl": "Wal-layli idhaa sajaa"}, {"n": 4, "tl": "Maa wadda'aka rabbuka wa maa qalaa"}, {"n": 5, "tl": "Wa lal-aakhiratu khayrun laka minal-oolaa"}, {"n": 6, "tl": "Wa lasawfa yu'teeka rabbuka fatardaa"}, {"n": 7, "tl": "Alam yajidka yateeman fa-aawaa"}, {"n": 8, "tl": "Wa wajadaka daallan fahadaa"}, {"n": 9, "tl": "Wa wajadaka aa'ilan fa-aghnaa"}, {"n": 10, "tl": "Fa-ammal-yateema falaa taqhar"}, {"n": 11, "tl": "Wa ammas-saa'ila falaa tanhar"}, {"n": 12, "tl": "Wa ammaa bini'mati rabbika fahaddith"}]}
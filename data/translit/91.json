{"ch": 91, "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Wa Ash-Shamsi Wa Đuĥāhā"}, {"n": 3, "tl": "Wa Al-Qamari 'Idhā Talāhā"}, {"n": 4, "tl": "Wa An-Nahāri 'Idhā Jallāhā"}, {"n": 5, "tl": "Wa Al-Layli 'Idhā Yaghshāhā"}, {"n": 6, "tl": "Wa As-Samā'i Wa Mā Banāhā"}, {"n": 7, "tl": "Wa Al-'Arđi Wa Mā Ţaĥāhā"}, {"n": 8, "tl": "Wa Nafsin Wa Mā Sawwāhā"}, {"n": 9, "tl": "Fa'alhamahā Fujūrahā Wa Taqwāhā"}, {"n": 10, "tl": "Qad 'Aflaĥa Man Zakkāhā"}, {"n": 11, "tl": "Wa Qad Khāba Man Dassāhā"}, {"n": 12, "tl": "Kadhdhabat Thamūdu Biţaghwāhā"}, {"n": 13, "tl": "'Idhi Anba`atha 'Ashqāhā"}, {"n": 14, "tl": "Faqāla Lahum Rasūlu Allāhi Nāqata Allāhi Wa Suqyāhā"}, {"n": 15, "tl": "Fakadhdhabūhu Fa`aqarūhā Fadamdama `Alayhim Rabbuhum Bidhanbihim Fasawwāhā"}, {"n": 16, "tl": "Wa Lā Yakhāfu `Uqbāhā"}]}
{"ch": 91, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Wash-shamsi wa duhaahaa"}, {"n": 3, "tl": "Wal-qamari idhaa talaahaa"}, {"n": 4, "tl": "Wan-nahaari idhaa jallaahaa"}, {"n": 5, "tl": "Wal-layli idhaa yaghshaahaa"}, {"n": 6, "tl": "Was-samaa'i wa maa banaahaa"}, {"n": 7, "tl": "Wal-ardi wa maa tahaahaa"}, {"n": 8, "tl": "Wa nafsin wa maa sawwaahaa"}, {"n": 9, "tl": "Fa-alhamahaa fujoorahaa wa taqwaahaa"}, {"n": 10, "tl": "Qad aflaha man zakkaahaa"}, {"n": 11, "tl": "Wa qad khaaba man dassaahaa"}, {"n": 12, "tl": "Kadhdhabat thamoodu bitaghwaahaa"}, {"n": 13, "tl": "Idhin-ba'atha ashqaahaa"}, {"n": 14, "tl": "Faqaala lahum rasoolullaahi naaqatallaahi wa suqyaahaa"}, {"n": 15, "tl": "Fakadhdhaboohu fa-aqaroohaa fadamdama alayhim rabbuhum bidhanbihim fasawwaahaa"}, {"n": 16, "tl": "Wa laa yakhaafu uqbaahaa"}]}
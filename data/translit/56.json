{"ch": 56, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Idhaa waqa'atil-waaqi'ah"}, {"n": 3, "tl": "Laysa liwaq'atihaa kaadhibah"}, {"n": 4, "tl": "Khaafidatun raafi'ah"}, {"n": 5, "tl": "Idhaa rujjatil-ardu rajjaa"}, {"n": 6, "tl": "Wa bussatil-jibaalu bassaa"}, {"n": 7, "tl": "Fakaanat habaa'an munbaththaa"}, {"n": 8, "tl": "Wa kuntum azwaajan thalaathah"}, {"n": 9, "tl": "Fa-ashaabul-maymanati maa ashaabul-maymanah"}, {"n": 10, "tl": "Wa ashaabul-mash'amati maa ashaabul-mash'amah"}, {"n": 11, "tl": "Was-saabiqoonas-saabiqoon"}, {"n": 12, "tl": "Ulaa'ikal-muqarraboon"}, {"n": 13, "tl": "Fee jannaatin-na'eem"}, {"n": 14, "tl": "Thullatun minal-awwaleen"}, {"n": 15, "tl": "Wa qaleelun minal-aakhireen"}, {"n": 16, "tl": "Alaa sururin mawdoonah"}, {"n": 17, "tl": "Muttaki'eena alayhaa mutaqaabileen"}, {"n": 18, "tl": "Yatoofu alayhim wildaanun mukhalladoon"}, {"n": 19, "tl": "Bi-akwaabin wa abaareeqa wa ka'sin min ma'een"}, {"n": 20, "tl": "Laa yusadda'oona anhaa wa laa yunzifoon"}, {"n": 21, "tl": "Wa faakihatin mimmaa yatakhayyaroon"}, {"n": 22, "tl": "Wa lahmi tayrin mimmaa yashtahoon"}, {"n": 23, "tl": "Wa hoorun een"}, {"n": 24, "tl": "Ka'amthaalil-lu'ulu'uil-maknoon"}, {"n": 25, "tl": "Jazaa'an bimaa kaanoo ya'maloon"}, {"n": 26, "tl": "Laa yasma'oona feehaa laghwan wa laa ta'theemaa"}, {"n": 27, "tl": "Illaa qeelan salaaman salaamaa"}, {"n": 28, "tl": "Wa ashaabul-yameeni maa ashaabul-yameen"}, {"n": 29, "tl": "Fee sidrin makhdood"}, {"n": 30, "tl": "Wa talhin mandood"}, {"n": 31, "tl": "Wa zillin mamdood"}, {"n": 32, "tl": "Wa maa'in maskoob"}, {"n": 33, "tl": "Wa faakihatin katheerah"}, {"n": 34, "tl": "Laa maqtoo'atin wa laa mamnoo'ah"}, {"n": 35, "tl": "Wa furushin marfoo'ah"}, {"n": 36, "tl": "Innaa ansha'naahunna inshaa'aa"}, {"n": 37, "tl": "Faja'alnaahunna abkaaraa"}, {"n": 38, "tl": "Uruban atraabaa"}, {"n": 39, "tl": "Li-ashaabil-yameen"}, {"n": 40, "tl": "Thullatun minal-awwaleen"}, {"n": 41, "tl": "Wa thullatun minal-aakhireen"}, {"n": 42, "tl": "Wa ashaabush-shimaali maa ashaabush-shimaal"}, {"n": 43, "tl": "Fee samoomin wa hameem"}, {"n": 44, "tl": "Wa zillin min yahmoom"}, {"n": 45, "tl": "Laa baaridin wa laa kareem"}, {"n": 46, "tl": "Innahum kaanoo qabla dhaalika mutrafeen"}, {"n": 47, "tl": "Wa kaanoo yusirroona alal-hinthil-azeem"}, {"n": 48, "tl": "Wa kaanoo yaqooloona a'idhaa mitnaa wa kunnaa turaaban wa izaaman a'innaa lamab'oothoon"}, {"n": 49, "tl": "Awa aabaa'uunal-awwaloon"}, {"n": 50, "tl": "Qul innal-awwaleena wal-aakhireen"}, {"n": 51, "tl": "Lamajmoo'oona ilaa meeqaati yawmin ma'loom"}, {"n": 52, "tl": "Thumma innakum ayyuhad-daalloonal-mukadhdhiboon"}, {"n": 53, "tl": "La-aakiloona min shajarin min zaqqoom"}, {"n": 54, "tl": "Famaali'oona minhal-butoon"}, {"n": 55, "tl": "Fashaariboona alayhi minal-hameem"}, {"n": 56, "tl": "Fashaariboona shurbal-heem"}, {"n": 57, "tl": "Haadhaa nuzuluhum yawmad-deen"}, {"n": 58, "tl": "Nahnu khalaqnaakum falawlaa tusaddiqoon"}, {"n": 59, "tl": "Afara'aytum maa tumnoon"}, {"n": 60, "tl": "A'antum takhluqoonahu am nahnul-khaaliqoon"}, {"n": 61, "tl": "Nahnu qaddarnaa baynakumul-mawta wa maa nahnu bimasbooqeen"}, {"n": 62, "tl": "Alaa an nubaddila amthaalakum wa nunshi'akum fee maa laa ta'lamoon"}, {"n": 63, "tl": "Wa laqad alimtumun-nash'atal-oolaa falawlaa tadhkkaroon"}, {"n": 64, "tl": "Afara'aytum maa tahruthoon"}, {"n": 65, "tl": "A'antum tazra'oonahu am nahnuz-zaari'oon"}, {"n": 66, "tl": "Law nashaa'u laja'alnaahu hutaaman fazalaltum tafakkahoon"}, {"n": 67, "tl": "Innaa lamughramoon"}, {"n": 68, "tl": "Bal nahnu mahroomoon"}, {"n": 69, "tl": "Afara'aytumul-maa'al-ladhee tashraboon"}, {"n": 70, "tl": "A'antum anzaltumoohu minal-muzni am nahnul-munziloon"}, {"n": 71, "tl": "Law nashaa'u ja'alnaahu ujaajan falawlaa tashkuroon"}, {"n": 72, "tl": "Afara'aytumun-naaral-latee tooroon"}, {"n": 73, "tl": "A'antum ansha'tum shajaratahaa am nahnul-munshi'oon"}, {"n": 74, "tl": "Nahnu ja'alnaahaa tadhkiratan wa mataa'an lilmuqween"}, {"n": 75, "tl": "Fasabbih biaasmi rabbikal-azeem"}, {"n": 76, "tl": "Falaa uqsimu bimawaaqi'in-nujoom"}, {"n": 77, "tl": "Wa innahu laqasamun law ta'lamoona azeem"}, {"n": 78, "tl": "Innahu laqur'aanun kareem"}, {"n": 79, "tl": "Fee kitaabin maknoon"}, {"n": 80, "tl": "Laa yamassuhu illal-mutahharoon"}, {"n": 81, "tl": "Tanzeelun min rabbil-aalameen"}, {"n": 82, "tl": "Afabihadhal-hadeethi antum mudhinoon"}, {"n": 83, "tl": "Wa taj'aloona rizqakum annakum tukadhdhiboon"}, {"n": 84, "tl": "Falawlaa idhaa balaghatil-hulqoom"}, {"n": 85, "tl": "Wa antum heena'idhin tanzuroon"}, {"n": 86, "tl": "Wa nahnu aqrabu ilayhi minkum wa laakin laa tubsiroon"}, {"n": 87, "tl": "Falawlaa in kuntum ghayra madeeneen"}, {"n": 88, "tl": "Tarji'oonahaa in kuntum saadiqeen"}, {"n": 89, "tl": "Fa-ammaa in kaana minal-muqarrabeen"}, {"n": 90, "tl": "Farawhun wa rayhaanun wa jannatu na'eem"}, {"n": 91, "tl": "Wa ammaa in kaana min ashaabil-yameen"}, {"n": 92, "tl": "Fasalaamun laka min ashaabil-yameen"}, {"n": 93, "tl": "Wa ammaa in kaana minal-mukadhdhibeenad-daalleen"}, {"n": 94, "tl": "Fanuzulun min hameem"}, {"n": 95, "tl": "Wa tasliyatu jaheem"}, {"n": 96, "tl": "Inna haadhaa lahuwa haqqul-yaqeen"}, {"n": 97, "tl": "Fasabbih biaasmi rabbikal-azeem"}]}
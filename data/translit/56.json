{"ch": 56, "source": "transliteration.org", "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "'Idhā Waqa`ati Al-Wāqi`ahu"}, {"n": 3, "tl": "Laysa Liwaq`atihā Kādhibahun"}, {"n": 4, "tl": "Khāfiđatun Rāfi`ahun"}, {"n": 5, "tl": "'Idhā Rujjati Al-'Arđu Rajjāan"}, {"n": 6, "tl": "Wa Bussati Al-Jibālu Bassāan"}, {"n": 7, "tl": "Fakānat Habā'an Munbaththāan"}, {"n": 8, "tl": "Wa Kuntum 'Azwājāan Thalāthahan"}, {"n": 9, "tl": "Fa'aşĥābu Al-Maymanati Mā 'Aşĥābu Al-Maymanati"}, {"n": 10, "tl": "Wa 'Aşĥābu Al-Mash'amati Mā 'Aşĥābu Al-Mash'amahi"}, {"n": 11, "tl": "Wa As-Sābiqūna As-Sābiqūna"}, {"n": 12, "tl": "'Ūlā'ika Al-Muqarrabūna"}, {"n": 13, "tl": "Fī Jannāti An-Na`īmi"}, {"n": 14, "tl": "Thullatun Mina Al-'Awwalīna"}, {"n": 15, "tl": "Wa Qalīlun Mina Al-'Ākhirīna"}, {"n": 16, "tl": "`Alá Sururin Mawđūnahin"}, {"n": 17, "tl": "Muttaki'īna `Alayhā Mutaqābilīna"}, {"n": 18, "tl": "Yaţūfu `Alayhim Wildānun Mukhalladūna"}, {"n": 19, "tl": "Bi'akwābin Wa 'Abārīqa Wa Ka'sin Min Ma`īnin"}, {"n": 20, "tl": "Lā Yuşadda`ūna `Anhā Wa Lā Yunzifūna"}, {"n": 21, "tl": "Wa Fākihatin Mimmā Yatakhayyarūna"}, {"n": 22, "tl": "Wa Laĥmi Ţayrin Mimmā Yashtahūna"}, {"n": 23, "tl": "Wa Ĥūrun `Īnun"}, {"n": 24, "tl": "Ka'amthāli Al-Lu'ulu'ui Al-Maknūni"}, {"n": 25, "tl": "Jazā'an Bimā Kānū Ya`malūna"}, {"n": 26, "tl": "Lā Yasma`ūna Fīhā Laghwan Wa Lā Ta'thīmāan"}, {"n": 27, "tl": "'Illā Qīlāan Salāmāan Salāmāan"}, {"n": 28, "tl": "Wa 'Aşĥābu Al-Yamīni Mā 'Aşĥābu Al-Yamīni"}, {"n": 29, "tl": "Fī Sidrin Makhđūdin"}, {"n": 30, "tl": "Wa Ţalĥin Manđūdin"}, {"n": 31, "tl": "Wa Žillin Mamdūdin"}, {"n": 32, "tl": "Wa Mā'in Maskūbin"}, {"n": 33, "tl": "Wa Fākihatin Kathīrahin"}, {"n": 34, "tl": "Lā Maqţū`atin Wa Lā Mamnū`ahin"}, {"n": 35, "tl": "Wa Furushin Marfū`ahin"}, {"n": 36, "tl": "'Innā 'Ansha'nāhunna 'Inshā'an"}, {"n": 37, "tl": "Faja`alnāhunna 'Abkārāan"}, {"n": 38, "tl": "`Urubāan 'Atrābāan"}, {"n": 39, "tl": "Li'aşĥābi Al-Yamīni"}, {"n": 40, "tl": "Thullatun Mina Al-'Awwalīna"}, {"n": 41, "tl": "Wa Thullatun Mina Al-'Ākhirīna"}, {"n": 42, "tl": "Wa 'Aşĥābu Ash-Shimāli Mā 'Aşĥābu Ash-Shimāli"}, {"n": 43, "tl": "Fī Samūmin Wa Ĥamīmin"}, {"n": 44, "tl": "Wa Žillin Min Yaĥmūmin"}, {"n": 45, "tl": "Lā Bāridin Wa Lā Karīmin"}, {"n": 46, "tl": "'Innahum Kānū Qabla Dhālika Mutrafīna"}, {"n": 47, "tl": "Wa Kānū Yuşirrūna `Alá Al-Ĥinthi Al-`Ažīmi"}, {"n": 48, "tl": "Wa Kānū Yaqūlūna 'A'idhā Mitnā Wa Kunnā Turābāan Wa `Ižāmāan 'A'innā Lamab`ūthūna"}, {"n": 49, "tl": "'Awa 'Ābā'uunā Al-'Awwalūna"}, {"n": 50, "tl": "Qul 'Inna Al-'Awwalīna Wa Al-'Ākhirīna"}, {"n": 51, "tl": "Lamajmū`ūna 'Ilá Mīqāti Yawmin Ma`lūmin"}, {"n": 52, "tl": "Thumma 'Innakum 'Ayyuhā Ađ-Đāllūna Al-Mukadhdhibūna"}, {"n": 53, "tl": "La'ākilūna Min Shajarin Min Zaqqūmin"}, {"n": 54, "tl": "Famāli'ūna Minhā Al-Buţūna"}, {"n": 55, "tl": "Fashāribūna `Alayhi Mina Al-Ĥamīmi"}, {"n": 56, "tl": "Fashāribūna Shurba Al-Hīmi"}, {"n": 57, "tl": "Hādhā Nuzuluhum Yawma Ad-Dīni"}, {"n": 58, "tl": "Naĥnu Khalaqnākum Falawlā Tuşaddiqūna"}, {"n": 59, "tl": "'Afara'aytum Mā Tumnūna"}, {"n": 60, "tl": "'A'antum Takhluqūnahu 'Am Naĥnu Al-Khāliqūna"}, {"n": 61, "tl": "Naĥnu Qaddarnā Baynakumu Al-Mawta Wa Mā Naĥnu Bimasbūqīna"}, {"n": 62, "tl": "`Alá 'An Nubaddila 'Amthālakum Wa Nunshi'akum Fī Mā Lā Ta`lamūna"}, {"n": 63, "tl": "Wa Laqad `Alimtumu An-Nash'ata Al-'Ūlá Falawlā Tadhkkarūna"}, {"n": 64, "tl": "'Afara'aytum Mā Taĥruthūna"}, {"n": 65, "tl": "'A'antum Tazra`ūnahu 'Am Naĥnu Az-Zāri`ūna"}, {"n": 66, "tl": "Law Nashā'u Laja`alnāhu Ĥuţāmāan Fažalaltum Tafakkahūna"}, {"n": 67, "tl": "'Innā Lamughramūna"}, {"n": 68, "tl": "Bal Naĥnu Maĥrūmūna"}, {"n": 69, "tl": "'Afara'aytumu Al-Mā'a Al-Ladhī Tashrabūna"}, {"n": 70, "tl": "'A'antum 'Anzaltumūhu Mina Al-Muzni 'Am Naĥnu Al-Munzilūna"}, {"n": 71, "tl": "Law Nashā'u Ja`alnāhu 'Ujājāan Falawlā Tashkurūna"}, {"n": 72, "tl": "'Afara'aytumu An-Nāra Allatī Tūrūna"}, {"n": 73, "tl": "'A'antum 'Ansha'tum Shajaratahā 'Am Naĥnu Al-Munshi'ūna"},
{"ch": 55, "source": "transliteration.org", "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Ar-Raĥmānu"}, {"n": 3, "tl": "`Allama Al-Qur'āna"}, {"n": 4, "tl": "Khalaqa Al-'Insāna"}, {"n": 5, "tl": "`Allamahu Al-Bayāna"}, {"n": 6, "tl": "Ash-Shamsu Wa Al-Qamaru Biĥusbānin"}, {"n": 7, "tl": "Wa An-Najmu Wa Ash-Shajaru Yasjudāni"}, {"n": 8, "tl": "Wa As-Samā'a Rafa`ahā Wa Wađa`a Al-Mīzāna"}, {"n": 9, "tl": "'Allā Taţghawā Fī Al-Mīzāni"}, {"n": 10, "tl": "Wa 'Aqīmū Al-Wazna Bil-Qisţi Wa Lā Tukhsirū Al-Mīzāna"}, {"n": 11, "tl": "Wa Al-'Arđa Wađa`ahā Lil'anāmi"}, {"n": 12, "tl": "Fīhā Fākihatun Wa An-Nakhlu Dhātu Al-'Akmāmi"}, {"n": 13, "tl": "Wa Al-Ĥabbu Dhū Al-`Aşfi Wa Ar-Rayĥānu"}, {"n": 14, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 15, "tl": "Khalaqa Al-'Insāna Min Şalşālin Kālfakhkhāri"}, {"n": 16, "tl": "Wa Khalaqa Al-Jānna Min Mārijin Min Nārin"}, {"n": 17, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 18, "tl": "Rabbu Al-Mashriqayni Wa Rabbu Al-Maghribayni"}, {"n": 19, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 20, "tl": "Maraja Al-Baĥrayni Yaltaqiyāni"}, {"n": 21, "tl": "Baynahumā Barzakhun Lā Yabghiyāni"}, {"n": 22, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 23, "tl": "Yakhruju Minhumā Al-Lu'ulu'uu Wa Al-Marjānu"}, {"n": 24, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 25, "tl": "Wa Lahu Al-Jawāri Al-Munsha'ātu Fī Al-Baĥri Kāl'a`lāmi"}, {"n": 26, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 27, "tl": "Kullu Man `Alayhā Fānin"}, {"n": 28, "tl": "Wa Yabqá Wajhu Rabbika Dhū Al-Jalāli Wa Al-'Ikrāmi"}, {"n": 29, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 30, "tl": "Yas'aluhu Man Fī As-Samāwāti Wa Al-'Arđi Kulla Yawmin Huwa Fī Sha'nin"}, {"n": 31, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 32, "tl": "Sanafrughu Lakum 'Ayyuhā Ath-Thaqalāni"}, {"n": 33, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 34, "tl": "Yā Ma`shara Al-Jinni Wa Al-'Insi 'Ini Astaţa`tum 'An Tanfudhū Min 'Aqţāri As-Samāwāti Wa Al-'Arđi Fānfudhū Lā Tanfudhūna 'Illā Bisulţānin"}, {"n": 35, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 36, "tl": "Yursalu `Alaykumā Shuwāžun Min Nārin Wa Nuĥāsun Falā Tantaşirāni"}, {"n": 37, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 38, "tl": "Fa'idhā Anshaqqati As-Samā'u Fakānat Wardatan Kālddihāni"}, {"n": 39, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 40, "tl": "Fayawma'idhin Lā Yus'alu `An Dhanbihi 'Insun Wa Lā Jānnun"}, {"n": 41, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 42, "tl": "Yu`rafu Al-Mujrimūna Bisīmāhum Fayu'ukhadhu Bin-Nawāşī Wa Al-'Aqdāmi"}, {"n": 43, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 44, "tl": "Hadhihi Jahannamu Allatī Yukadhdhibu Bihā Al-Mujrimūna"}, {"n": 45, "tl": "Yaţūfūna Baynahā Wa Bayna Ĥamīmin 'Ānin"}, {"n": 46, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 47, "tl": "Wa Liman Khāfa Maqāma Rabbihi Jannatāni"}, {"n": 48, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 49, "tl": "Dhawātā 'Afnānin"}, {"n": 50, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 51, "tl": "Fīhimā `Aynāni Tajriyāni"}, {"n": 52, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 53, "tl": "Fīhimā Min Kulli Fākihatin Zawjāni"}, {"n": 54, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 55, "tl": "Muttaki'īna `Alá Furushin Baţā'inuhā Min 'Istabraqin Wa Janá Al-Jannatayni Dānin"}, {"n": 56, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 57, "tl": "Fīhinna Qāşirātu Aţ-Ţarfi Lam Yaţmithhunna 'Insun Qablahum Wa Lā Jānnun"}, {"n": 58, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 59, "tl": "Ka'annahunna Al-Yāqūtu Wa Al-Marjānu"}, {"n": 60, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 61, "tl": "Hal Jazā'u Al-'Iĥsāni 'Illā Al-'Iĥsānu"}, {"n": 62, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 63, "tl": "Wa Min Dūnihimā Jannatāni"}, {"n": 64, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 65, "tl": "Mud/hāmmatāni"}, {"n": 66, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 67, "tl": "Fīhimā `Aynāni Nađđākhatāni"}, {"n": 68, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 69, "tl": "Fīhimā Fākihatun Wa Nakhlun Wa Rummānun"}, {"n": 70, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 71, "tl": "Fīhinna Khayrātun Ĥisānun"}, {"n": 72, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 73, "tl": "Ĥūrun Maqşūrātun Fī Al-Khiyāmi"}, {"n": 74, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 75, "tl": "Lam Yaţmithhunna 'Insun Qablahum Wa Lā Jānnun"}, {"n": 76, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 77, "tl": "Muttaki'īna `Alá Rafrafin Khuđrin Wa `Abqarīyin Ĥisānin"}, {"n": 78, "tl": "Fabi'ayyi 'Ālā'i Rabbikumā Tukadhdhibāni"}, {"n": 79, "tl": "Tabāraka Asmu Rabbika Dhī Al-Jalāli Wa Al-'Ikrāmi"}]}
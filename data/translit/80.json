{"ch": 80, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Abasa wa tawallaa"}, {"n": 3, "tl": "An jaa'ahul-a'maa"}, {"n": 4, "tl": "Wa maa yudreeka la-allahu yazzakkaa"}, {"n": 5, "tl": "Aw yadhdhakkaru fatanfa'ahudh-dhikraa"}, {"n": 6, "tl": "Ammaa manis-taghnaa"}, {"n": 7, "tl": "Fa-anta lahu tasaddaa"}, {"n": 8, "tl": "Wa maa alayka allaa yazzakkaa"}, {"n": 9, "tl": "Wa ammaa man jaa'aka yas'aa"}, {"n": 10, "tl": "Wa huwa yakhshaa"}, {"n": 11, "tl": "Fa-anta anhu talahhaa"}, {"n": 12, "tl": "Kallaa innahaa tadhkirah"}, {"n": 13, "tl": "Faman shaa'a dhakarah"}, {"n": 14, "tl": "Fee suhufin mukarramah"}, {"n": 15, "tl": "Marfoo'atin mutahharah"}, {"n": 16, "tl": "Bi-aydee safarah"}, {"n": 17, "tl": "Kiraamin bararah"}, {"n": 18, "tl": "Qutilal-insaanu maa akfarah"}, {"n": 19, "tl": "Min ayyi shay'in khalaqah"}, {"n": 20, "tl": "Min nutfatin khalaqahu faqaddarah"}, {"n": 21, "tl": "Thummas-sabeela yassarah"}, {"n": 22, "tl": "Thumma amaatahu fa-aqbarah"}, {"n": 23, "tl": "Thumma idhaa shaa'a ansharah"}, {"n": 24, "tl": "Kallaa lammaa yaqdi maa amarah"}, {"n": 25, "tl": "Falyanzuril-insaanu ilaa ta'aamih"}, {"n": 26, "tl": "Annaa sababnal-maa'a sabbaa"}, {"n": 27, "tl": "Thumma shaqaqnal-arda shaqqaa"}, {"n": 28, "tl": "Fa-anbatnaa feehaa habbaa"}, {"n": 29, "tl": "Wa inaban wa qadbaa"}, {"n": 30, "tl": "Wa zaytoonan wa nakhlaa"}, {"n": 31, "tl": "Wa hadaa'iqa ghulbaa"}, {"n": 32, "tl": "Wa faakihatan wa abbaa"}, {"n": 33, "tl": "Mataa'an lakum wa li-an'aamikum"}, {"n": 34, "tl": "Fa-idhaa jaa'atis-saakhkhah"}, {"n": 35, "tl": "Yawma yafirrul-mar'u min akheeh"}, {"n": 36, "tl": "Wa ummihi wa abeeh"}, {"n": 37, "tl": "Wa saahibatihi wa baneeh"}, {"n": 38, "tl": "Likulli imri'in minhum yawma'idhin sha'nun yughneeh"}, {"n": 39, "tl": "Wujoohun yawma'idhin musfirah"}, {"n": 40, "tl": "Daahikatun mustabshirah"}, {"n": 41, "tl": "Wa wujoohun yawma'idhin alayhaa ghabarah"}, {"n": 42, "tl": "Tarhaquhaa qatarah"}, {"n": 43, "tl": "Ulaa'ika humul-kafaratul-fajarah"}]}
{"ch": 90, "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Lā 'Uqsimu Bihadhā Al-Baladi"}, {"n": 3, "tl": "Wa 'Anta Ĥillun Bihadhā Al-Baladi"}, {"n": 4, "tl": "Wa Wālidin Wa Mā Walada"}, {"n": 5, "tl": "Laqad Khalaqnā Al-'Insāna Fī Kabadin"}, {"n": 6, "tl": "'Ayaĥsabu 'An Lan Yaqdira `Alayhi 'Aĥadun"}, {"n": 7, "tl": "Yaqūlu 'Ahlaktu Mālāan Lubadāan"}, {"n": 8, "tl": "'Ayaĥsabu 'An Lam Yarahu 'Aĥadun"}, {"n": 9, "tl": "'Alam Naj`al Lahu `Aynayni"}, {"n": 10, "tl": "Wa Lisānāan Wa Shafatayni"}, {"n": 11, "tl": "Wa Hadaynāhu An-Najdayni"}, {"n": 12, "tl": "Falā Aqtaĥama Al-`Aqabaha"}, {"n": 13, "tl": "Wa Mā 'Adrāka Mā Al-`Aqabahu"}, {"n": 14, "tl": "Fakku Raqabahin"}, {"n": 15, "tl": "'Aw 'Iţ`āmun Fī Yawmin Dhī Masghabahin"}, {"n": 16, "tl": "Yatīmāan Dhā Maqrabahin"}, {"n": 17, "tl": "'Aw Miskīnāan Dhā Matrabahin"}, {"n": 18, "tl": "Thumma Kāna Mina Al-Ladhīna 'Āmanū Wa Tawāşawā Biş-Şabri Wa Tawāşawā Bil-Marĥamahi"}, {"n": 19, "tl": "'Ūlā'ika 'Aşĥābu Al-Maymanati"}, {"n": 20, "tl": "Wa Al-Ladhīna Kafarū Bi'āyātinā Hum 'Aşĥābu Al-Mash'amahi"}, {"n": 21, "tl": "`Alayhim Nārun Mu'uşadahun"}]}
{"ch": 90, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Laa uqsimu bihadhal-balad"}, {"n": 3, "tl": "Wa anta hillun bihadhal-balad"}, {"n": 4, "tl": "Wa waalidin wa maa walad"}, {"n": 5, "tl": "Laqad khalaqnal-insaana fee kabad"}, {"n": 6, "tl": "Ayahsabu an lan yaqdira alayhi ahad"}, {"n": 7, "tl": "Yaqoolu ahlaktu maalan lubadaa"}, {"n": 8, "tl": "Ayahsabu an lam yarahu ahad"}, {"n": 9, "tl": "Alam naj'al lahu aynayn"}, {"n": 10, "tl": "Wa lisaanan wa shafatayn"}, {"n": 11, "tl": "Wa hadaynaahun-najdayn"}, {"n": 12, "tl": "Falaq-tahamal-aqabah"}, {"n": 13, "tl": "Wa maa adraaka mal-aqabah"}, {"n": 14, "tl": "Fakku raqabah"}, {"n": 15, "tl": "Aw it'aamun fee yawmin dhee masghabah"}, {"n": 16, "tl": "Yateeman dhaa maqrabah"}, {"n": 17, "tl": "Aw miskeenan dhaa matrabah"}, {"n": 18, "tl": "Thumma kaana minal-ladheena aamanoo wa tawaasaw bis-sabri wa tawaasaw bil-marhamah"}, {"n": 19, "tl": "Ulaa'ika ashaabul-maymanah"}, {"n": 20, "tl": "Wal-ladheena kafaroo bi-aayaatinaa hum ashaabul-mash'amah"}, {"n": 21, "tl": "Alayhim naarun mu'sadah"}]}
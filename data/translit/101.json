{"ch": 101, "source": "transliteration.org", "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Al-Qāri`ahu"}, {"n": 3, "tl": "Mā Al-Qāri`ahu"}, {"n": 4, "tl": "Wa Mā 'Adrāka Mā Al-Qāri`ahu"}, {"n": 5, "tl": "Yawma Yakūnu An-Nāsu Kālfarāshi Al-Mabthūthi"}, {"n": 6, "tl": "Wa Takūnu Al-Jibālu Kāl`ihni Al-Manfūshi"}, {"n": 7, "tl": "Fa'ammā Man Thaqulat Mawāzīnuhu"}, {"n": 8, "tl": "Fahuwa Fī `Īshatin Rāđiyahin"}, {"n": 9, "tl": "Wa 'Ammā Man Khaffat Mawāzīnuhu"}, {"n": 10, "tl": "Fa'ummuhu Hāwiyahun"}, {"n": 11, "tl": "Wa Mā 'Adrāka Mā Hiyah"}, {"n": 12, "tl": "Nārun Ĥāmiyahun"}]}
{"ch": 100, "source": "transliteration.org", "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Wa Al-`Ādiyāti Đabĥāan"}, {"n": 3, "tl": "Fālmūriyāti Qadĥāan"}, {"n": 4, "tl": "Fālmughīrāti Şubĥāan"}, {"n": 5, "tl": "Fa'atharna Bihi Naq`āan"}, {"n": 6, "tl": "Fawasaţna Bihi Jam`āan"}, {"n": 7, "tl": "'Inna Al-'Insāna Lirabbihi Lakanūdun"}, {"n": 8, "tl": "Wa 'Innahu `Alá Dhālika Lashahīdun"}, {"n": 9, "tl": "Wa 'Innahu Liĥubbi Al-Khayri Lashadīdun"}, {"n": 10, "tl": "'Afalā Ya`lamu 'Idhā Bu`thira Mā Fī Al-Qubūri"}, {"n": 11, "tl": "Wa Ĥuşşila Mā Fī Aş-Şudūri"}, {"n": 12, "tl": "'Inna Rabbahum Bihim Yawma'idhin Lakhabīrun"}]}
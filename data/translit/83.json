{"ch": 83, "source": "transliteration.org", "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Waylun Lilmuţaffifīna"}, {"n": 3, "tl": "Al-Ladhīna 'Idhā Aktālū `Alá An-Nāsi Yastawfūna"}, {"n": 4, "tl": "Wa 'Idhā Kālūhum Aw Wazanūhum Yukhsirūna"}, {"n": 5, "tl": "'Alā Yažunnu 'Ūla'ika 'Annahum Mab`ūthūna"}, {"n": 6, "tl": "Liyawmin `Ažīmin"}, {"n": 7, "tl": "Yawma Yaqūmu An-Nāsu Lirabbi Al-`Ālamīna"}, {"n": 8, "tl": "Kallā Inna Kitāba Al-Fujjāri Lafī Sijjīnin"}, {"n": 9, "tl": "Wa Mā 'Adrāka Mā Sijjīnun"}, {"n": 10, "tl": "Kitābun Marqūmun"}, {"n": 11, "tl": "Waylun Yawma'idhin Lilmukadhdhibīna"}, {"n": 12, "tl": "Al-Ladhīna Yukadhdhibūna Biyawmi Ad-Dīni"}, {"n": 13, "tl": "Wa Mā Yukadhdhibu Bihi Illā Kullu Mu`tadin 'Athīmin"}, {"n": 14, "tl": "'Idhā Tutlá `Alayhi 'Āyātunā Qāla 'Asāţīru Al-'Awwalīna"}, {"n": 15, "tl": "Kallā Bal Rāna `Alá Qulūbihim Mā Kānū Yaksibūna"}, {"n": 16, "tl": "Kallā Innahum `An Rabbihim Yawma'idhin Lamaĥjūbūna"}, {"n": 17, "tl": "Thumma 'Innahum Laşālū Al-Jaĥīmi"}, {"n": 18, "tl": "Thumma Yuqālu Hādhā Al-Ladhī Kuntum Bihi Tukadhdhibūna"}, {"n": 19, "tl": "Kallā Inna Kitāba Al-'Abrāri Lafī `Illīyīna"}, {"n": 20, "tl": "Wa Mā 'Adrāka Mā `Illīyūna"}, {"n": 21, "tl": "Kitābun Marqūmun"}, {"n": 22, "tl": "Yash/haduhu Al-Muqarrabūna"}, {"n": 23, "tl": "'Inna Al-'Abrāra Lafī Na`īmin"}, {"n": 24, "tl": "`Alá Al-'Arā'iki Yanžurūna"}, {"n": 25, "tl": "Ta`rifu Fī Wujūhihim Nađrata An-Na`īmi"}, {"n": 26, "tl": "Yusqawna Min Raĥīqin Makhtūmin"}, {"n": 27, "tl": "Khitāmuhu Miskun Wa Fī Dhālika Falyatanāfasi Al-Mutanāfisūna"}, {"n": 28, "tl": "Wa Mizājuhu Min Tasnīmin"}, {"n": 29, "tl": "`Aynāan Yashrabu Bihā Al-Muqarrabūna"}, {"n": 30, "tl": "'Inna Al-Ladhīna 'Ajramū Kānū Mina Al-Ladhīna 'Āmanū Yađĥakūna"}, {"n": 31, "tl": "Wa 'Idhā Marrū Bihim Yataghāmazūna"}, {"n": 32, "tl": "Wa 'Idhā Anqalabū Ilá 'Ahlihimu Anqalabū Fakihīna"}, {"n": 33, "tl": "Wa 'Idhā Ra'awhum Qālū Inna Hā'uulā' Lađāllūna"}, {"n": 34, "tl": "Wa Mā Ursilū `Alayhim Ĥāfižīna"}, {"n": 35, "tl": "Fālyawma Al-Ladhīna 'Āmanū Mina Al-Kuffāri Yađĥakūna"}, {"n": 36, "tl": "`Alá Al-'Arā'iki Yanžurūna"}, {"n": 37, "tl": "Hal Thūwiba Al-Kuffāru Mā Kānū Yaf`alūna"}]}
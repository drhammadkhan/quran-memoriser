{"ch": 83, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Waylun lilmutaffifeen"}, {"n": 3, "tl": "Al-ladheena idhak-taaloo alan-naasi yastawfoon"}, {"n": 4, "tl": "Wa idhaa kaaloohum aw wazanoohum yukhsiroon"}, {"n": 5, "tl": "Alaa yazunnu oola'ika annahum mab'oothoon"}, {"n": 6, "tl": "Liyawmin azeem"}, {"n": 7, "tl": "Yawma yaqoomun-naasu lirabbil-aalameen"}, {"n": 8, "tl": "Kallaa inna kitaabal-fujjaari lafee sijjeen"}, {"n": 9, "tl": "Wa maa adraaka maa sijjeen"}, {"n": 10, "tl": "Kitaabun marqoom"}, {"n": 11, "tl": "Waylun yawma'idhin lilmukadhdhibeen"}, {"n": 12, "tl": "Al-ladheena yukadhdhiboona biyawmid-deen"}, {"n": 13, "tl": "Wa maa yukadhdhibu bihi illaa kullu mu'tadin atheem"}, {"n": 14, "tl": "Idhaa tutlaa alayhi aayaatunaa qaala asaateerul-awwaleen"}, {"n": 15, "tl": "Kallaa bal raana alaa quloobihim maa kaanoo yaksiboon"}, {"n": 16, "tl": "Kallaa innahum an rabbihim yawma'idhin lamahjooboon"}, {"n": 17, "tl": "Thumma innahum lasaalul-jaheem"}, {"n": 18, "tl": "Thumma yuqaalu haadhal-ladhee kuntum bihi tukadhdhiboon"}, {"n": 19, "tl": "Kallaa inna kitaabal-abraari lafee illiyyeen"}, {"n": 20, "tl": "Wa maa adraaka maa illiyyoon"}, {"n": 21, "tl": "Kitaabun marqoom"}, {"n": 22, "tl": "Yashhaduhul-muqarraboon"}, {"n": 23, "tl": "Innal-abraara lafee na'eem"}, {"n": 24, "tl": "Alal-araa'iki yanzuroon"}, {"n": 25, "tl": "Ta'rifu fee wujoohihim nadratan-na'eem"}, {"n": 26, "tl": "Yusqawna min raheeqin makhtoom"}, {"n": 27, "tl": "Khitaamuhu miskun wa fee dhaalika falyatanaafasil-mutanaafisoon"}, {"n": 28, "tl": "Wa mizaajuhu min tasneem"}, {"n": 29, "tl": "Aynan yashrabu bihal-muqarraboon"}, {"n": 30, "tl": "Innal-ladheena ajramoo kaanoo minal-ladheena aamanoo yadhakoon"}, {"n": 31, "tl": "Wa idhaa marroo bihim yataghaamazoon"}, {"n": 32, "tl": "Wa idhan-qalaboo ilaa ahlihimu inqalaboo fakiheen"}, {"n": 33, "tl": "Wa idhaa ra'awhum qaaloo inna haa'ulaa'i ladaalloon"}, {"n": 34, "tl": "Wa maa ursiloo alayhim haafizeen"}, {"n": 35, "tl": "Fal-yawmal-ladheena aamanoo minal-kuffaari yadhakoon"}, {"n": 36, "tl": "Alal-araa'iki yanzuroon"}, {"n": 37, "tl": "Hal thuwwibal-kuffaaru maa kaanoo yaf'aloon"}]}
{"ch": 81, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Idhash-shamsu kuwwirat"}, {"n": 3, "tl": "Wa idhan-nujoomu inkadarat"}, {"n": 4, "tl": "Wa idhal-jibaalu suyyirat"}, {"n": 5, "tl": "Wa idhal-ishaaru uttilat"}, {"n": 6, "tl": "Wa idhal-wuhooshu hushirat"}, {"n": 7, "tl": "Wa idhal-bihaaru sujjirat"}, {"n": 8, "tl": "Wa idhan-nufoosu zuwwijat"}, {"n": 9, "tl": "Wa idhal-maw'oodatu su'ilat"}, {"n": 10, "tl": "Bi-ayyi dhanbin qutilat"}, {"n": 11, "tl": "Wa idhas-suhufu nushirat"}, {"n": 12, "tl": "Wa idhas-samaa'u kushitat"}, {"n": 13, "tl": "Wa idhal-jaheemu su'irat"}, {"n": 14, "tl": "Wa idhal-jannatu uzlifat"}, {"n": 15, "tl": "Alimat nafsun maa ahdarat"}, {"n": 16, "tl": "Falaa uqsimu bil-khunnas"}, {"n": 17, "tl": "Al-jawaaril-kunnas"}, {"n": 18, "tl": "Wal-layli idhaa as'as"}, {"n": 19, "tl": "Was-subhi idhaa tanaffas"}, {"n": 20, "tl": "Innahu laqawlu rasoolin kareem"}, {"n": 21, "tl": "Dhee quwwatin inda dhil-arshi makeen"}, {"n": 22, "tl": "Mutaa'in thamma ameen"}, {"n": 23, "tl": "Wa maa saahibukum bimajnoon"}, {"n": 24, "tl": "Wa laqad ra'aahu bil-ufuqil-mubeen"}, {"n": 25, "tl": "Wa maa huwa alal-ghaybi bidaneen"}, {"n": 26, "tl": "Wa maa huwa biqawli shaytaanin rajeem"}, {"n": 27, "tl": "Fa-ayna tadhhaboon"}, {"n": 28, "tl": "In huwa illaa dhikrun lil-aalameen"}, {"n": 29, "tl": "Liman shaa'a minkum an yastaqeem"}, {"n": 30, "tl": "Wa maa tashaa'oona illaa an yashaa'a Allaahu rabbul-aalameen"}]}
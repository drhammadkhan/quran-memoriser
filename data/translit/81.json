{"ch": 81, "source": "transliteration.org", "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "'Idhā Ash-Shamsu Kūwirat"}, {"n": 3, "tl": "Wa 'Idhā An-Nujūmu Ankadarat"}, {"n": 4, "tl": "Wa 'Idhā Al-Jibālu Suyyirat"}, {"n": 5, "tl": "Wa 'Idhā Al-`Ishāru `Uţţilat"}, {"n": 6, "tl": "Wa 'Idhā Al-Wuĥūshu Ĥushirat"}, {"n": 7, "tl": "Wa 'Idhā Al-Biĥāru Sujjirat"}, {"n": 8, "tl": "Wa 'Idhā An-Nufūsu Zūwijat"}, {"n": 9, "tl": "Wa 'Idhā Al-Maw'ūdatu Su'ilat"}, {"n": 10, "tl": "Bi'ayyi Dhanbin Qutilat"}, {"n": 11, "tl": "Wa 'Idhā Aş-Şuĥufu Nushirat"}, {"n": 12, "tl": "Wa 'Idhā As-Samā'u Kushiţat"}, {"n": 13, "tl": "Wa 'Idhā Al-Jaĥīmu Su``irat"}, {"n": 14, "tl": "Wa 'Idhā Al-Jannatu 'Uzlifat"}, {"n": 15, "tl": "`Alimat Nafsun Mā 'Aĥđarat"}, {"n": 16, "tl": "Falā Uqsimu Bil-Khunnasi"}, {"n": 17, "tl": "Al-Jawāri Al-Kunnasi"}, {"n": 18, "tl": "Wa Al-Layli 'Idhā `As`asa"}, {"n": 19, "tl": "Wa Aş-Şubĥi 'Idhā Tanaffasa"}, {"n": 20, "tl": "'Innahu Laqawlu Rasūlin Karīmin"}, {"n": 21, "tl": "Dhī Qūwatin `Inda Dhī Al-`Arshi Makīnin"}, {"n": 22, "tl": "Muţā`in Thamma 'Amīnin"}, {"n": 23, "tl": "Wa Mā Şāĥibukum Bimajnūnin"}, {"n": 24, "tl": "Wa Laqad Ra'āhu Bil-'Ufuqi Al-Mubīni"}, {"n": 25, "tl": "Wa Mā Huwa `Alá Al-Ghaybi Biđanīnin"}, {"n": 26, "tl": "Wa Mā Huwa Biqawli Shayţānin Rajīmin"}, {"n": 27, "tl": "Fa'ayna Tadh/habūna"}, {"n": 28, "tl": "'In Huwa 'Illā Dhikrun Lil`ālamīna"}, {"n": 29, "tl": "Liman Shā'a Minkum 'An Yastaqīma"}, {"n": 30, "tl": "Wa Mā Tashā'ūna 'Illā 'An Yashā'a Allāhu Rabbu Al-`Ālamīna"}]}
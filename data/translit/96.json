{"ch": 96, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Iqra biaasmi rabbikal-ladhee khalaq"}, {"n": 3, "tl": "Khalaqal-insaana min alaq"}, {"n": 4, "tl": "Iqra wa rabbukal-akram"}, {"n": 5, "tl": "Al-ladhee allama bil-qalam"}, {"n": 6, "tl": "Allamal-insaana maa lam ya'lam"}, {"n": 7, "tl": "Kallaa innal-insaana layatghaa"}, {"n": 8, "tl": "An ra'aahu istaghnaa"}, {"n": 9, "tl": "Inna ilaa rabbikar-ruj'aa"}, {"n": 10, "tl": "Ara'aytal-ladhee yanhaa"}, {"n": 11, "tl": "Abdan idhaa sallaa"}, {"n": 12, "tl": "Ara'ayta in kaana alal-hudaa"}, {"n": 13, "tl": "Aw amara bit-taqwaa"}, {"n": 14, "tl": "Ara'ayta in kadhdhaba wa tawallaa"}, {"n": 15, "tl": "Alam ya'lam bi-anna Allaaha yaraa"}, {"n": 16, "tl": "Kallaa la-in lam yantahi lanasfa'an bin-naasiyah"}, {"n": 17, "tl": "Naasiyatin kaadhibatin khaati'ah"}, {"n": 18, "tl": "Falyad'u naadiyah"}, {"n": 19, "tl": "Sanad'uz-zabaaniyah"}, {"n": 20, "tl": "Kallaa laa tuti'hu wasjud waaqtarib"}]}
{"ch": 96, "verses": [{"n": 2, "tl": "A qra' Biāsmi Rabbika Al-Ladhī Kh alaqa"}, {"n": 3, "tl": "Kh alaqa Al-'Insāna Min `Alaqin"}, {"n": 4, "tl": "A qra' Wa Rabbuka Al-'Akramu"}, {"n": 5, "tl": "Al-Ladhī `Allama Bil-Qalami"}, {"n": 6, "tl": "`Allama Al-'Insāna Mā Lam"}, {"n": 7, "tl": "Kallā 'Inna Al-'Insāna Layaţghá"}, {"n": 8, "tl": "'An Ra'āhu A staghná"}, {"n": 9, "tl": "'Inna 'Ilá Rabbika Ar-Ruj`á"}, {"n": 10, "tl": "'Ara'ayta Al-Ladhī Yanhá"}, {"n": 11, "tl": "`Abdāan 'Idhā Şallá"}, {"n": 12, "tl": "'Ara'ayta 'In Kāna `Alá Al-Hudá"}, {"n": 13, "tl": "'Aw Amara Bit-Taqwá"}, {"n": 14, "tl": "'Ara'ayta 'In Kadhdhaba Wa Tawallá"}, {"n": 15, "tl": "'Alam Ya`lam Bi'anna Allāha Yará"}, {"n": 16, "tl": "Kallā La'in Lam Yantahi Lanasfa`ā Bin-Nāşiyahi"}, {"n": 17, "tl": "Nāşiyatin Kādhibatin Khāţi'ahin"}, {"n": 18, "tl": "Falyad`u Nādiyah"}, {"n": 19, "tl": "Sanad`u Az-Zabāniyaha"}, {"n": 20, "tl": "Kallā Lā Tuţi`hu Wa Asjud"}]}
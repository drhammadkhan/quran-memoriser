{"ch": 96, "source": "transliteration.org", "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Aqra' Biāsmi Rabbika Al-Ladhī Khalaqa"}, {"n": 3, "tl": "Khalaqa Al-'Insāna Min `Alaqin"}, {"n": 4, "tl": "Aqra' Wa Rabbuka Al-'Akramu"}, {"n": 5, "tl": "Al-Ladhī `Allama Bil-Qalami"}, {"n": 6, "tl": "`Allama Al-'Insāna Mā Lam Ya`lam"}, {"n": 7, "tl": "Kallā 'Inna Al-'Insāna Layaţghá"}, {"n": 8, "tl": "'An Ra'āhu Astaghná"}, {"n": 9, "tl": "'Inna 'Ilá Rabbika Ar-Ruj`á"}, {"n": 10, "tl": "'Ara'ayta Al-Ladhī Yanhá"}, {"n": 11, "tl": "`Abdāan 'Idhā Şallá"}, {"n": 12, "tl": "'Ara'ayta 'In Kāna `Alá Al-Hudá"}, {"n": 13, "tl": "'Aw 'Amara Bit-Taqwá"}, {"n": 14, "tl": "'Ara'ayta 'In Kadhdhaba Wa Tawallá"}, {"n": 15, "tl": "'Alam Ya`lam Bi'anna Allāha Yará"}, {"n": 16, "tl": "Kallā La'in Lam Yantahi Lanasfa`āan Bin-Nāşiyahi"}, {"n": 17, "tl": "Nāşiyatin Kādhibatin Khāţi'ahin"}, {"n": 18, "tl": "Falyad`u Nādiyah"}, {"n": 19, "tl": "Sanad`u Az-Zabāniyaha"}, {"n": 20, "tl": "Kallā Lā Tuţi`hu Wa Asjud Wāqtarib"}]}
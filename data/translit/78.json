{"ch": 78, "verses": [{"n": 1, "tl": "Bismillaahir-Rahmaanir-Raheem"}, {"n": 2, "tl": "Amma yatasaa'aloon"}, {"n": 3, "tl": "Anin-naba'il-azeem"}, {"n": 4, "tl": "Al-ladhee hum feehi mukhtalifoon"}, {"n": 5, "tl": "Kallaa saya'lamoon"}, {"n": 6, "tl": "Thumma kallaa saya'lamoon"}, {"n": 7, "tl": "Alam naj'alil-arda mihaadaa"}, {"n": 8, "tl": "Wal-jibaala awtaadaa"}, {"n": 9, "tl": "Wa khalaqnaakum azwaajaa"}, {"n": 10, "tl": "Wa ja'alnaa nawmakum subaataa"}, {"n": 11, "tl": "Wa ja'alnal-layla libaasaa"}, {"n": 12, "tl": "Wa ja'alnan-nahaara ma'aashaa"}, {"n": 13, "tl": "Wa banaynaa fawqakum sab'an shidaadaa"}, {"n": 14, "tl": "Wa ja'alnaa siraajan wahhaajaa"}, {"n": 15, "tl": "Wa anzalnaa minal-mu'siraati maa'an thajjaajaa"}, {"n": 16, "tl": "Linukhrija bihi habban wa nabaataa"}, {"n": 17, "tl": "Wa jannaatin alfaafaa"}, {"n": 18, "tl": "Inna yawmal-fasli kaana meeqaataa"}, {"n": 19, "tl": "Yawma yunfakhu fis-soori fata'toona afwaajaa"}, {"n": 20, "tl": "Wa futihatis-samaa'u fakaanat abwaabaa"}, {"n": 21, "tl": "Wa suyyiratil-jibaalu fakaanat saraabaa"}, {"n": 22, "tl": "Inna jahannama kaanat mirsaadaa"}, {"n": 23, "tl": "Lit-taagheena ma'aabaa"}, {"n": 24, "tl": "Laabitheena feehaa ahqaabaa"}, {"n": 25, "tl": "Laa yadhooqoona feehaa bardan wa laa sharaabaa"}, {"n": 26, "tl": "Illaa hameeman wa ghassaaqaa"}, {"n": 27, "tl": "Jazaa'an wifaaqaa"}, {"n": 28, "tl": "Innahum kaanoo laa yarjoona hisaabaa"}, {"n": 29, "tl": "Wa kadhdhaboo bi-aayaatinaa kidhdhaabaa"}, {"n": 30, "tl": "Wa kulla shay'in ahsaynaahu kitaabaa"}, {"n": 31, "tl": "Fadhooqoo falan nazeedakum illaa adhaabaa"}, {"n": 32, "tl": "Inna lilmuttaqeena mafaazaa"}, {"n": 33, "tl": "Hadaa'iqa wa a'naabaa"}, {"n": 34, "tl": "Wa kawaa'iba atraabaa"}, {"n": 35, "tl": "Wa ka'san dihaaqaa"}, {"n": 36, "tl": "Laa yasma'oona feehaa laghwan wa laa kidhdhaabaa"}, {"n": 37, "tl": "Jazaa'an min rabbika ataa'an hisaabaa"}, {"n": 38, "tl": "Rabbis-samaawaati wal-ardi wa maa baynahumar-Rahmaani laa yamlikoona minhu khitaabaa"}, {"n": 39, "tl": "Yawma yaqoomur-roohu wal-malaa'ikatu saffan laa yatakallamoona illaa man adhina lahur-Rahmaanu wa qaala sawaabaa"}, {"n": 40, "tl": "Dhaalikal-yawmul-haqqu faman shaa'a ittakhadha ilaa rabbihi ma'aabaa"}, {"n": 41, "tl": "Innaa andharnaakum adhaaban qareeban yawma yanzurul-mar'u maa qaddamat yadaahu wa yaqoolul-kaafiru yaa laytanee kuntu turaabaa"}]}
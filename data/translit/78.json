{"ch": 78, "source": "transliteration.org", "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "`Amma Yatasā'alūna"}, {"n": 3, "tl": "`Ani An-Naba'i Al-`Ažīmi"}, {"n": 4, "tl": "Al-Ladhī Hum Fīhi Mukhtalifūna"}, {"n": 5, "tl": "Kallā Saya`lamūna"}, {"n": 6, "tl": "Thumma Kallā Saya`lamūna"}, {"n": 7, "tl": "'Alam Naj`ali Al-'Arđa Mihādāan"}, {"n": 8, "tl": "Wa Al-Jibāla 'Awtādāan"}, {"n": 9, "tl": "Wa Khalaqnākum 'Azwājāan"}, {"n": 10, "tl": "Wa Ja`alnā Nawmakum Subātāan"}, {"n": 11, "tl": "Wa Ja`alnā Al-Layla Libāsāan"}, {"n": 12, "tl": "Wa Ja`alnā An-Nahāra Ma`āshāan"}, {"n": 13, "tl": "Wa Banaynā Fawqakum Sab`āan Shidādāan"}, {"n": 14, "tl": "Wa Ja`alnā Sirājāan Wa Hhājāan"}, {"n": 15, "tl": "Wa 'Anzalnā Mina Al-Mu`şirāti Mā'an Thajjājāan"}, {"n": 16, "tl": "Linukhrija Bihi Ĥabbāan Wa Nabātāan"}, {"n": 17, "tl": "Wa Jannātin 'Alfāfāan"}, {"n": 18, "tl": "'Inna Yawma Al-Faşli Kāna Mīqātāan"}, {"n": 19, "tl": "Yawma Yunfakhu Fī Aş-Şūri Fata'tūna 'Afwājāan"}, {"n": 20, "tl": "Wa Futiĥati As-Samā'u Fakānat 'Abwābāan"}, {"n": 21, "tl": "Wa Suyyirati Al-Jibālu Fakānat Sarābāan"}, {"n": 22, "tl": "'Inna Jahannama Kānat Mirşādāan"}, {"n": 23, "tl": "Lilţţāghīna Ma'ābāan"}, {"n": 24, "tl": "Lābithīna Fīhā 'Aĥqābāan"}, {"n": 25, "tl": "Lā Yadhūqūna Fīhā Bardāan Wa Lā Sharābāan"}, {"n": 26, "tl": "'Illā Ĥamīmāan Wa Ghassāqāan"}, {"n": 27, "tl": "Jazā'an Wifāqāan"}, {"n": 28, "tl": "'Innahum Kānū Lā Yarjūna Ĥisābāan"}, {"n": 29, "tl": "Wa Kadhdhabū Bi'āyātinā Kidhdhābāan"}, {"n": 30, "tl": "Wa Kulla Shay'in 'Aĥşaynāhu Kitābāan"}, {"n": 31, "tl": "Fadhūqū Falan Nazīdakum 'Illā `Adhābāan"}, {"n": 32, "tl": "'Inna Lilmuttaqīna Mafāzāan"}, {"n": 33, "tl": "Ĥadā'iqa Wa 'A`nābāan"}, {"n": 34, "tl": "Wa Kawā`iba 'Atrābāan"}, {"n": 35, "tl": "Wa Ka'sāan Dihāqāan"}, {"n": 36, "tl": "Lā Yasma`ūna Fīhā Laghwan Wa Lā Kidhdhābāan"}, {"n": 37, "tl": "Jazā'an Min Rabbika `Aţā'an Ĥisābāan"}, {"n": 38, "tl": "Rabbi As-Samāwāti Wa Al-'Arđi Wa Mā Baynahumā Ar-Raĥmani Lā Yamlikūna Minhu Khiţābāan"}, {"n": 39, "tl": "Yawma Yaqūmu Ar-Rūĥu Wa Al-Malā'ikatu Şaffāan Lā Yatakallamūna 'Illā Man 'Adhina Lahu Ar-Raĥmānu Wa Qāla Şawābāan"}, {"n": 40, "tl": "Dhālika Al-Yawmu Al-Ĥaqqu Faman Shā'a Attakhadha 'Ilá Rabbihi Ma'ābāan"}, {"n": 41, "tl": "'Innā 'Andharnākum `Adhābāan Qarībāan Yawma Yanžuru Al-Mar'u Mā Qaddamat Yadāhu Wa Yaqūlu Al-Kāfiru Yā Laytanī Kuntu Turābāan"}]}
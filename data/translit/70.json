{"ch": 70, "verses": [{"n": 1, "tl": "Bismi Allāhi Ar-Raĥmāni Ar-Raĥīmi"}, {"n": 2, "tl": "Sa'ala Sā'ilun Bi`adhābin Wāqi`in"}, {"n": 3, "tl": "Lilkāfiryna Laysa Lahu Dāfi`un"}, {"n": 4, "tl": "Mina Allāhi Dhī Al-Ma`āriji"}, {"n": 5, "tl": "Ta`ruju Al-Malā'ikatu Wa Ar-Rūĥu 'Ilayhi Fī Yawmin Kāna Miqdāruhu Khamsīna 'Alfa Sanahin"}, {"n": 6, "tl": "Fāşbir Şabrāan Jamīlāan"}, {"n": 7, "tl": "'Innahum Yarawnahu Ba`īdāan"}, {"n": 8, "tl": "Wa Narāhu Qarībāan"}, {"n": 9, "tl": "Yawma Takūnu As-Samā'u Kālmuhli"}, {"n": 10, "tl": "Wa Takūnu Al-Jibālu Kāl`ihni"}, {"n": 11, "tl": "Wa Lā Yas'alu Ĥamīmun Ĥamīmāan"}, {"n": 12, "tl": "Yubaşşarūnahum Yawaddu Al-Mujrimu Law Yaftadī Min `Adhābi Yawmi'idhin Bibanīhi"}, {"n": 13, "tl": "Wa Şāĥibatihi Wa 'Akhīhi"}, {"n": 14, "tl": "Wa Faşīlatihi Allatī Tu'uwyhi"}, {"n": 15, "tl": "Wa Man Fī Al-'Arđi Jamī`āan Thumma Yunjīhi"}, {"n": 16, "tl": "Kallā 'Innahā Lažá"}, {"n": 17, "tl": "Nazzā`atan Lilshshawá"}, {"n": 18, "tl": "Tad`ū Man 'Adbara Wa Tawallá"}, {"n": 19, "tl": "Wa Jama`a Fa'aw`á"}, {"n": 20, "tl": "'Inna Al-'Insāna Khuliqa Halū`āan"}, {"n": 21, "tl": "'Idhā Massahu Ash-Sharru Jazū`āan"}, {"n": 22, "tl": "Wa 'Idhā Massahu Al-Khayru Manū`āan"}, {"n": 23, "tl": "'Illā Al-Muşallīna"}, {"n": 24, "tl": "Al-Ladhīna Hum `Alá Şalātihim Dā'imūna"}, {"n": 25, "tl": "Wa Al-Ladhīna Fī 'Amwālihim Ĥaqqun Ma`lūmun"}, {"n": 26, "tl": "Lilssā'ili Wa Al-Maĥrūmi"}, {"n": 27, "tl": "Wa Al-Ladhīna Yuşaddiqūna Biyawmi Ad-Dīni"}, {"n": 28, "tl": "Wa Al-Ladhīna Hum Min `Adhābi Rabbihim Mushfiqūna"}, {"n": 29, "tl": "'Inna `Adhāba Rabbihim Ghayru Ma'mūnin"}, {"n": 30, "tl": "Wa Al-Ladhīna Hum Lifurūjihim Ĥāfižūna"}, {"n": 31, "tl": "'Illā `Alá 'Azwājihim 'Aw Mā Malakat 'Aymānuhum Fa'innahum Ghayru Malūmīna"}, {"n": 32, "tl": "Famani Abtaghá Warā'a Dhālika Fa'ūlā'ika Humu Al-`Ādūna"}, {"n": 33, "tl": "Wa Al-Ladhīna Hum Li'mānātihim Wa `Ahdihim Rā`ūna"}, {"n": 34, "tl": "Wa Al-Ladhīna Hum Bishahādātihim Qā'imūna"}, {"n": 35, "tl": "Wa Al-Ladhīna Hum `Alá Şalātihim Yuĥāfižūna"}, {"n": 36, "tl": "'Ūlā'ika Fī Jannātin Mukramūna"}, {"n": 37, "tl": "Famāli Al-Ladhīna Kafarū Qibalaka Muhţi`īna"}, {"n": 38, "tl": "`Ani Al-Yamīni Wa `Ani Ash-Shimāli `Izīna"}, {"n": 39, "tl": "'Ayaţma`u Kullu Amri'in Minhum 'An Yudkhala Jannata Na`īmin"}, {"n": 40, "tl": "Kallā 'Innā Khalaqnāhum Mimmā Ya`lamūna"}, {"n": 41, "tl": "Falā 'Uqsimu Birabbi Al-Mashāriqi Wa Al-Maghāribi 'Innā Laqādirūna"}, {"n": 42, "tl": "`Alá 'An Nubaddila Khayrāan Minhum Wa Mā Naĥnu Bimasbūqīna"}, {"n": 43, "tl": "Fadharhum Yakhūđū Wa Yal`abū Ĥattá Yulāqū Yawmahumu Al-Ladhī Yū`adūna"}, {"n": 44, "tl": "Yawma Yakhrujūna Mina Al-'Ajdāthi Sirā`āan Ka'annahum 'Ilá Nuşubin Yūfiđūna"}, {"n": 45, "tl": "Khāshi`atan 'Abşāruhum Tarhaquhum Dhillatun Dhālika Al-Yawmu Al-Ladhī Kānū Yū`adūna"}]}
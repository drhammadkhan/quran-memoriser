{"ch": 114, "verses": [{"n": 1, "ar": "بِسۡمِ اللّٰہِ الرَّحۡمٰنِ الرَّحِیۡمِ ﴿۱﴾", "en": "In the name of Allah, the Gracious, the Merciful.", "w": ["in the name of", "Allah", "the Gracious", "the Merciful", ""]}, {"n": 2, "ar": "قُلۡ اَعُوۡذُ بِرَبِّ النَّاسِ ۙ﴿۲﴾", "en": "Say, ‘I seek refuge in the Lord of mankind,", "w": ["say", "I seek refuge", "in the Lord", "of mankind", ""]}, {"n": 3, "ar": "مَلِکِ النَّاسِ ۙ﴿۳﴾", "en": "‘The King of mankind,", "w": ["the King", "of mankind", ""]}, {"n": 4, "ar": "اِلٰہِ النَّاسِ ۙ﴿۴﴾", "en": "‘The God of mankind,", "w": ["the God", "of mankind", ""]}, {"n": 5, "ar": "مِنۡ شَرِّ الۡوَسۡوَاسِ ۬ۙ الۡخَنَّاسِ ۪ۙ﴿۵﴾", "en": "‘From the evil of the sneaking whisperer,", "w": ["from", "the evil of", "whisperer", "", "the sneaking", ""]}, {"n": 6, "ar": "الَّذِیۡ یُوَسۡوِسُ فِیۡ صُدُوۡرِ النَّاسِ ۙ﴿۶﴾", "en": "‘Who whispers into the hearts of men,", "w": ["who", "whispers", "into", "the hearts", "of men", ""]}, {"n": 7, "ar": "مِنَ الۡجِنَّۃِ وَالنَّاسِ ﴿٪۷﴾", "en": "‘From among the Jinn and mankind.’", "w": ["from among", "the Jinn", "and mankind", ""]}]}
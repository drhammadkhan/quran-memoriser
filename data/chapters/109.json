{"ch": 109, "verses": [{"n": 1, "ar": "بِسۡمِ اللّٰہِ الرَّحۡمٰنِ الرَّحِیۡمِ ﴿۱﴾", "en": "In the name of Allah, the Gracious, the Merciful.", "w": ["in the name of", "Allah", "the Gracious", "the Merciful", ""]}, {"n": 2, "ar": "قُلۡ یٰۤاَیُّہَا الۡکٰفِرُوۡنَ ۙ﴿۲﴾", "en": "Say, ‘O ye disbelievers!", "w": ["say", "O ye", "disbelievers", ""]}, {"n": 3, "ar": "لَاۤ اَعۡبُدُ مَا تَعۡبُدُوۡنَ ۙ﴿۳﴾", "en": "‘I worship not that which you worship;", "w": ["not", "I worship", "that which", "you worship", ""]}, {"n": 4, "ar": "وَلَاۤ اَنۡتُمۡ عٰبِدُوۡنَ مَاۤ اَعۡبُدُ ۚ﴿۴﴾", "en": "‘Nor worship you what I worship.", "w": ["nor", "you", "worship", "what", "I worship", ""]}, {"n": 5, "ar": "وَلَاۤ اَنَا عَابِدٌ مَّا عَبَدۡتُّمۡ ۙ﴿۵﴾", "en": "‘And I am not <i>going</i> to worship that which you worship;", "w": ["and not", "I am", "<i>going</i> to worship", "that which", "you worship", ""]}, {"n": 6, "ar": "وَلَاۤ اَنۡتُمۡ عٰبِدُوۡنَ مَاۤ اَعۡبُدُ ؕ﴿۶﴾", "en": "‘Nor will you worship what I worship.", "w": ["nor will", "you", "worship", "what", "I worship", ""]}, {"n": 7, "ar": "لَکُمۡ دِیۡنُکُمۡ وَلِیَ دِیۡنِ ﴿٪۷﴾", "en": "‘For you your religion, and for me my religion.’", "w": ["for you", "your religion", "and for me", "my religion", ""]}]}
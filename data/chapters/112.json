{"ch": 112, "verses": [{"n": 1, "ar": "بِسۡمِ اللّٰہِ الرَّحۡمٰنِ الرَّحِیۡمِ ﴿۱﴾", "en": "In the name of Allah, the Gracious, the Merciful.", "w": ["in the name of", "Allah", "the Gracious", "the Merciful", ""]}, {"n": 2, "ar": "قُلۡ ہُوَ اللّٰہُ اَحَدٌ ۚ﴿۲﴾", "en": "Say, ‘He is Allah, the One;", "w": ["say", "He is", "Allah", "the One", ""]}, {"n": 3, "ar": "اَللّٰہُ الصَّمَدُ ۚ﴿۳﴾", "en": "‘Allah, the Independent and Besought of all.", "w": ["Allah", "the Independent and Besought of all", ""]}, {"n": 4, "ar": "لَمۡ یَلِدۡ ۬ۙ وَلَمۡ یُوۡلَدۡ ۙ﴿۴﴾", "en": "‘He begets not, nor is He begotten;", "w": ["not", "He begets", "", "nor", "is He begotten", ""]}, {"n": 5, "ar": "وَلَمۡ یَکُنۡ لَّہٗ کُفُوًا اَحَدٌ ﴿٪۵﴾", "en": "‘And there is none like unto Him.’", "w": ["and none", "there is", "unto Him", "like", "any (one)", ""]}]}
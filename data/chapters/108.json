{"ch": 108, "verses": [{"n": 1, "ar": "بِسۡمِ اللّٰہِ الرَّحۡمٰنِ الرَّحِیۡمِ ﴿۱﴾", "en": "In the name of Allah, the Gracious, the Merciful.", "w": ["in the name of", "Allah", "the Gracious", "the Merciful", ""]}, {"n": 2, "ar": "اِنَّاۤ اَعۡطَیۡنٰکَ الۡکَوۡثَرَ ؕ﴿۲﴾", "en": "Surely We have given thee abundance <i>of good</i>;", "w": ["surely", "We have given thee", "abundance <i>of good</i>", ""]}, {"n": 3, "ar": "فَصَلِّ لِرَبِّکَ وَانۡحَرۡ ؕ﴿۳﴾", "en": "So pray to thy Lord, and offer sacrifice.", "w": ["so pray", "to thy Lord", "and offer sacrifice", ""]}, {"n": 4, "ar": "اِنَّ شَانِئَکَ ہُوَ الۡاَبۡتَرُ ﴿٪۴﴾", "en": "Surely, it is thy enemy who is without issue.", "w": ["surely", "it is thy enemy", "who is", "without issue", ""]}]}